---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/fraunces/opsz-italic.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
// Mismo archivo que referencia opsz.css, así que Vite lo emite una sola vez.
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Psicóloga colegiada en Madrid. Terapia individual, de pareja y familiar. Online y presencial."
} = Astro.props;

// URL oficial de la página en adrianapsicologia.com (sin barra final), para
// que Google no indexe las copias de otros entornos (workers.dev, vercel.app).
const canonical = new URL(Astro.url.pathname.replace(/\/+$/, '') || '/', Astro.site);
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} • Adriana Esteban Psicología</title>
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
  <!-- Marca que hay JS antes del primer pintado: los .reveal solo se ocultan
       con esta clase, así que sin JS el contenido se ve. El ClientRouter
       reemplaza los atributos de <html> en cada navegación, de ahí el
       after-swap. -->
  <script is:inline>
    document.documentElement.classList.add('js');
    document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
  </script>
  <ClientRouter />
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <Nav />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer />

  <button
    id="backToTop"
    class="back-to-top"
    aria-label="Volver arriba"
    type="button"
    transition:persist
    transition:name="back-to-top"
  >
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 19V5" />
      <path d="m5 12 7-7 7 7" />
    </svg>
  </button>
</body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';

  /* ── View Transitions ──────────────────────────────────────────
     Fade 220ms. La nav usa transition:persist → no participa.
     Calendly es cross-origin → excluido automáticamente por el browser.
  ──────────────────────────────────────────────────────────────── */

  /* Prevent white flash: root background matches site background */
  html { background-color: var(--color-bg-base); }

  @keyframes vt-fade-in  { from { opacity: 0; } }
  @keyframes vt-fade-out { to   { opacity: 0; } }

  /* Default root fade */
  ::view-transition-old(root) {
    animation: 220ms ease-out both vt-fade-out;
    background: var(--color-bg-base);
  }
  ::view-transition-new(root) {
    animation: 220ms ease-in  both vt-fade-in;
    background: var(--color-bg-base);
  }

  /* Named transition: hero H1 morphs between pages */
  ::view-transition-old(hero-title),
  ::view-transition-new(hero-title) {
    animation-duration: 300ms;
    animation-timing-function: ease-in-out;
  }

  /* Reduced motion: skip all transforms, instant swap */
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(root),
    ::view-transition-new(root),
    ::view-transition-old(hero-title),
    ::view-transition-new(hero-title) {
      animation-duration: 0ms;
    }
  }

  /* ── Saltar al contenido (WCAG 2.4.1) ── */
  .skip-link {
    position: absolute;
    left: 16px;
    top: -200px;
    z-index: 100;
    padding: 12px 18px;
    border-radius: var(--radius-lg);
    background: var(--color-moss);
    color: var(--color-text-inverse);
    font-family: var(--font-sans);
    font-weight: var(--fw-semi);
    font-size: var(--fs-body-sm);
    text-decoration: none;
    --focus-ring: var(--color-moss);
  }
  .skip-link:focus { top: 16px; }
  #contenido:focus { outline: none; }

  /* ── Botón "volver arriba" (solo mobile) ── */
  .back-to-top {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 40;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-full);
    border: none;
    background: var(--color-moss);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-md);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity var(--transition-base), transform var(--transition-base), visibility var(--transition-base);
  }
  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }
  .back-to-top:hover { background: var(--color-moss-hover); }

  @media (min-width: 1000px) {
    .back-to-top { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .back-to-top { transition: opacity var(--transition-fast); transform: none; }
  }
</style>

<script>
  // Enlaces que abren pestaña nueva: se avisa en su nombre accesible sin
  // cambiar el texto visible (WCAG 3.2.5 / G201). Cubre también nav y pie,
  // que persisten entre navegaciones (de ahí la marca data-newtab).
  const NEW_TAB = ' (se abre en una pestaña nueva)';
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLAnchorElement>('a[target="_blank"]:not([data-newtab])').forEach((a) => {
      a.dataset.newtab = '';
      const label = a.getAttribute('aria-label');
      if (label) { a.setAttribute('aria-label', label + NEW_TAB); return; }
      if (a.querySelector('.sr-only')) return;
      const hint = document.createElement('span');
      hint.className = 'sr-only';
      hint.textContent = NEW_TAB;
      a.appendChild(hint);
    });
  });

  // Desplegables (<details>: preguntas frecuentes, normativa): se abren y
  // cierran animando la altura y con un fundido del contenido. Con
  // movimiento reducido se usa el comportamiento nativo, sin animación.
  const ACC_EASE = 'cubic-bezier(0.33, 1, 0.68, 1)';
  function setupAccordion(d: HTMLDetailsElement) {
    const summary = d.querySelector('summary');
    if (!summary || d.dataset.acc) return;
    d.dataset.acc = '';
    let anim: Animation | null = null;
    let closing = false;

    const content = () => Array.from(d.children).filter((el) => el !== summary) as HTMLElement[];
    const closedHeight = () => {
      const cs = getComputedStyle(d);
      return summary.offsetHeight + parseFloat(cs.paddingTop) + parseFloat(cs.paddingBottom)
        + parseFloat(cs.borderTopWidth) + parseFloat(cs.borderBottomWidth);
    };
    const finish = (open: boolean) => {
      d.open = open;
      d.classList.remove('is-closing');
      d.style.height = '';
      d.style.overflow = '';
      anim = null;
      closing = false;
    };

    summary.addEventListener('click', (e) => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      e.preventDefault();
      const from = d.offsetHeight;
      anim?.cancel();
      d.style.overflow = 'hidden';

      if (!d.open || closing) {
        // Abrir (o revertir un cierre a medias)
        d.classList.remove('is-closing');
        closing = false;
        d.open = true;
        const to = d.scrollHeight + parseFloat(getComputedStyle(d).borderTopWidth) + parseFloat(getComputedStyle(d).borderBottomWidth);
        anim = d.animate({ height: [`${from}px`, `${to}px`] }, { duration: 420, easing: ACC_EASE });
        content().forEach((el) => el.animate(
          { opacity: [0, 1], transform: ['translateY(-6px)', 'translateY(0)'] },
          { duration: 360, delay: 80, easing: ACC_EASE, fill: 'backwards' },
        ));
        anim.onfinish = () => finish(true);
      } else {
        // Cerrar: la flecha gira ya al empezar
        closing = true;
        d.classList.add('is-closing');
        anim = d.animate({ height: [`${from}px`, `${closedHeight()}px`] }, { duration: 340, easing: ACC_EASE });
        content().forEach((el) => el.animate({ opacity: [1, 0] }, { duration: 200, easing: 'ease-out', fill: 'forwards' }));
        anim.onfinish = () => {
          content().forEach((el) => el.getAnimations().forEach((a) => a.cancel()));
          finish(false);
        };
      }
    });
  }
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLDetailsElement>('details').forEach(setupAccordion);
  });

  // astro:page-load fires on every navigation (including first load)
  // so the IntersectionObserver is re-created for each page's .reveal elements.
  document.addEventListener('astro:page-load', () => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const elements = Array.from(document.querySelectorAll('.reveal'));

    if (reduced) {
      elements.forEach(el => el.classList.add('revealed'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    elements.forEach(el => observer.observe(el));
  });

  // Botón "volver arriba": persiste entre navegaciones (transition:persist),
  // así que el listener se registra una única vez y sigue funcionando.
  const backToTop = document.getElementById('backToTop');
  const SHOW_THRESHOLD = 400;
  let btTicking = false;

  function updateBackToTop() {
    btTicking = false;
    backToTop?.classList.toggle('visible', window.scrollY > SHOW_THRESHOLD);
  }

  window.addEventListener('scroll', () => {
    if (btTicking) return;
    btTicking = true;
    requestAnimationFrame(updateBackToTop);
  }, { passive: true });

  backToTop?.addEventListener('click', () => {
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: smooth ? 'smooth' : 'auto' });
  });

  // Recalcula el estado tras cada navegación SPA (la posición de scroll
  // cambia de página a página).
  document.addEventListener('astro:page-load', updateBackToTop);
</script>