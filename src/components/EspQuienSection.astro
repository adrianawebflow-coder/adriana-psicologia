---
import { getImage } from 'astro:assets';
import adrianaImg from '../assets/adriana.png';

const avatar = await getImage({ src: adrianaImg, width: 160, format: 'webp' });

const especialidades = [
  {
    title: "Ansiedad y estrés",
    desc: "Herramientas para gestionar la preocupación constante, los ataques de pánico y la tensión crónica del día a día.",
  },
  {
    title: "Depresión y estado de ánimo",
    desc: "Herramientas para gestionar la preocupación constante, los ataques de pánico y la tensión crónica del día a día.",
  },
  {
    title: "Autoestima e identidad",
    desc: "Herramientas para gestionar la preocupación constante, los ataques de pánico y la tensión crónica del día a día.",
  },
  {
    title: "Duelo y pérdida",
    desc: "Herramientas para gestionar la preocupación constante, los ataques de pánico y la tensión crónica del día a día.",
  },
  {
    title: "Terapia de pareja",
    desc: "Herramientas para gestionar la preocupación constante, los ataques de pánico y la tensión crónica del día a día.",
  },
];
---

<section class="esp" id="sobre">
  <div class="container">
    <div class="esp-grid">

      <!-- Especialidades -->
      <div class="esp-col reveal">
        <h2 class="section-title">Especialidades</h2>
        <div class="esp-row" id="espRow">
          <div class="timeline">
            <div class="rail" aria-hidden="true">
              <span class="rail-fill"></span>
              <span class="rail-dot"></span>
            </div>
            <ul role="tablist" aria-label="Especialidades" aria-orientation="vertical">
              {especialidades.map((e, i) => (
                <li role="presentation">
                  <button
                    type="button"
                    role="tab"
                    id={`esp-tab-${i}`}
                    aria-controls={`esp-panel-${i}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    tabindex={i === 0 ? 0 : -1}
                    class:list={['esp-tab', { active: i === 0 }]}
                  >
                    {e.title}
                  </button>
                </li>
              ))}
            </ul>
          </div>
          <div class="esp-card-col">
          <div class="esp-desc">
            {especialidades.map((e, i) => (
              <div
                class:list={['esp-panel', { active: i === 0 }]}
                role="tabpanel"
                id={`esp-panel-${i}`}
                aria-labelledby={`esp-tab-${i}`}
              >
                <h3>{e.title}</h3>
                <p>{e.desc}</p>
              </div>
            ))}
            <span class="esp-progress" aria-hidden="true"><span class="esp-progress-bar"></span></span>
          </div>
          <!-- Pausa del paso automático (WCAG 2.2.2) -->
          <button class="esp-toggle" id="espToggle" type="button" hidden>
            <svg class="ico-pause" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
            <svg class="ico-play" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
            <span class="esp-toggle-label">Pausar</span>
          </button>
          </div>
        </div>
      </div>

      <!-- Quién soy -->
      <div class="quien-col reveal">
        <h2 class="section-title">¿Quién soy?</h2>
        <div class="quien-card">
          <div class="quien-head">
            <div class="avatar" role="img" aria-label="Foto de Adriana" style={`background-image:url('${avatar.src}')`}></div>
            <h3>¡Hola, soy Adriana!</h3>
          </div>
          <p>
            Me hice psicóloga porque quería entender por qué las personas
            hacemos lo que hacemos. Lo que de verdad me enganchó fue acompañar
            a alguien en ese proceso de entenderse a sí misma.
          </p>
          <a class="btn" href="/sobre-mi">Conocer más<span class="sr-only"> sobre Adriana</span> →</a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
.esp {
  background: var(--color-bg-base);
  padding-top: var(--section-pad-top);
  padding-bottom: var(--section-pad-bottom);
}

.container {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

.esp-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-16);
}

.section-title {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 var(--space-6);
}

/* ── Timeline ── */
.esp-row {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.timeline {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0 14px;
  align-items: start;
}

/* Raíl: pista suave + relleno que crece hasta la especialidad activa y un
   punto que se desliza hasta ella. JS fija --dot-y (centro del botón activo). */
.rail {
  --dot-y: 7px;
  position: relative;
  width: 5px;
  margin-left: 6px;
  border-radius: 3px;
  background: var(--color-moss-soft);
  align-self: stretch;
}
.rail-fill {
  position: absolute;
  inset: 0 0 auto 0;
  height: var(--dot-y);
  border-radius: inherit;
  background: var(--color-moss);
  transition: height 520ms cubic-bezier(0.65, 0, 0.35, 1);
}
.rail-dot {
  position: absolute;
  left: 50%;
  top: 0;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--color-moss);
  box-shadow: 0 0 0 0 rgba(63, 91, 58, 0.35);
  transform: translate(-50%, calc(var(--dot-y) - 7px));
  transition: transform 520ms cubic-bezier(0.65, 0, 0.35, 1);
  animation: esp-pulse 2.4s ease-out infinite;
}
@keyframes esp-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(63, 91, 58, 0.35); }
  70%  { box-shadow: 0 0 0 9px rgba(63, 91, 58, 0); }
  100% { box-shadow: 0 0 0 0 rgba(63, 91, 58, 0); }
}

.timeline ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.esp-tab {
  display: block;
  width: 100%;
  text-align: left;
  background: none;
  border: 0;
  border-radius: 6px;
  padding: 6px 8px;
  margin-left: -8px;
  cursor: pointer;
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  font-weight: var(--fw-semi);
  line-height: 1.3;
  color: var(--color-text-muted); /* 6.3:1 sobre bg-base (antes secondary al 72 %: 4.1:1) */
  transition: color 300ms ease, transform 300ms ease;
}
.esp-tab:hover { color: var(--color-text-secondary); }
.esp-tab.active {
  color: var(--color-text-primary);
  transform: translateX(4px);
}
.esp-tab:focus-visible {
  outline: 2px solid var(--color-moss);
  outline-offset: 2px;
}

.esp-desc {
  position: relative;
  display: grid;
  overflow: hidden;
  background: #FAF9F5;
  border: 1px solid var(--color-clay-soft);
  border-left: 4px solid var(--color-clay);
  border-radius: var(--radius-lg);
  padding: var(--space-5);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  line-height: var(--lh-body);
  color: var(--color-text-primary);
  box-shadow: var(--shadow-sm);
  touch-action: pan-y;
}

.esp-card-col {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: var(--space-2);
}
.esp-card-col .esp-desc { align-self: stretch; }
.esp-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  min-height: 36px;
  padding: 0 14px;
  border-radius: var(--radius-full);
  border: 1px solid var(--color-bg-border);
  background: transparent;
  color: var(--color-text-secondary);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  cursor: pointer;
}
.esp-toggle:hover { border-color: var(--color-moss); color: var(--color-moss); }
.esp-toggle .ico-play { display: none; }
.esp-toggle.is-paused .ico-play { display: block; }
.esp-toggle.is-paused .ico-pause { display: none; }

/* Todos los paneles comparten celda: la tarjeta toma la altura del más alto
   y no salta al cambiar de especialidad. */
.esp-panel {
  grid-area: 1 / 1;
  visibility: hidden;
  opacity: 0;
  transform: translateY(14px);
  filter: blur(4px);
  transition: opacity 420ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1), filter 420ms ease, visibility 0s linear 420ms;
}
.esp-panel.active {
  visibility: visible;
  opacity: 1;
  transform: none;
  filter: none;
  transition-delay: 120ms, 120ms, 120ms, 0s;
}
.esp-panel.leaving {
  transform: translateY(-14px);
}
.esp-panel h3 {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  margin: 0 0 var(--space-2);
}
.esp-panel p { margin: 0; color: var(--color-text-secondary); }

/* Barra de progreso del autoplay: su animación marca el tiempo y al
   terminar (animationend) se avanza a la siguiente especialidad. */
.esp-progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 3px;
  background: transparent;
}
.esp-progress-bar {
  display: block;
  height: 100%;
  width: 100%;
  background: var(--color-clay);
  opacity: 0.55;
  transform: scaleX(0);
  transform-origin: left center;
}
.esp-row.playing .esp-progress-bar {
  animation: esp-progress 5.5s linear forwards;
}
.esp-row.paused .esp-progress-bar {
  animation-play-state: paused;
}
@keyframes esp-progress {
  to { transform: scaleX(1); }
}

@media (prefers-reduced-motion: reduce) {
  .rail-fill, .rail-dot, .esp-tab, .esp-panel { transition: none; }
  .rail-dot { animation: none; }
  .esp-panel { filter: none; transform: none; }
  .esp-progress { display: none; }
}

/* ── Quién soy ── */
.quien-card {
  display: flex;
  flex-direction: column;
  gap: var(--space-5);
}

.quien-head {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.avatar {
  width: 80px;
  height: 80px;
  border-radius: var(--radius-full);
  background: var(--color-bg-muted) center / cover no-repeat;
  border: 4px solid var(--color-bg-base);
  box-shadow: var(--shadow-md);
  flex-shrink: 0;
}

.quien-card h3 {
  font-family: var(--font-sans);
  font-size: var(--fs-h4);
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  margin: 0;
}

.quien-card p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: var(--lh-body);
  color: var(--color-text-secondary);
  margin: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 52px;
  padding: 0 22px;
  background: var(--color-moss);
  color: var(--color-text-inverse);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-semi);
  border-radius: var(--radius-full);
  text-decoration: none;
  align-self: stretch;
  transition: background var(--transition-fast), transform var(--transition-fast);
}
.btn:hover {
  background: var(--color-moss-hover);
  transform: translateY(-1px);
}

@media (min-width: 880px) {
  .esp {
    padding-top: var(--section-pad-top);
  padding-bottom: var(--section-pad-bottom);
  }
  .esp-grid {
    /* 70 / 30 dentro de las 10 columnas centrales del grid de 12 */
    grid-template-columns: 7fr 3fr;
    column-gap: 80px;
    align-items: start;
    /* 1 columna de margen a cada lado → ocupa 10 de las 12 columnas */
    margin-inline: calc(100% / 12);
  }
  .esp-row {
    flex-direction: row;
    align-items: flex-start;
    gap: var(--col-gap);
  }
  .esp-desc {
    margin-top: 0;
  }
}
</style>

<script>
  // Especialidades: recorre las especialidades en bucle. El punto del raíl
  // baja hasta la activa y la tarjeta cambia de texto. Se pausa con hover,
  // foco o fuera de pantalla; clic/teclado/swipe permiten elegir a mano.
  function initEsp() {
    const rowEl = document.getElementById('espRow');
    if (!rowEl || rowEl.dataset.ready) return;
    rowEl.dataset.ready = '1';
    const row = rowEl;

    const tabs = Array.from(row.querySelectorAll<HTMLButtonElement>('.esp-tab'));
    const panels = Array.from(row.querySelectorAll<HTMLElement>('.esp-panel'));
    const rail = row.querySelector<HTMLElement>('.rail');
    const card = row.querySelector<HTMLElement>('.esp-desc');
    const bar = row.querySelector<HTMLElement>('.esp-progress-bar');
    const toggle = row.querySelector<HTMLButtonElement>('#espToggle');
    if (!tabs.length || !rail || !card || !bar) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let idx = 0;
    let inView = false;
    let hovering = false;
    let focused = false;
    // Si la persona pulsa pausa o elige una especialidad, el paso automático
    // ya no vuelve solo (WCAG 2.2.2). Con movimiento reducido no hay autoplay.
    let userPaused = reduced;

    function syncToggle() {
      if (!toggle) return;
      toggle.classList.toggle('is-paused', userPaused);
      const label = toggle.querySelector('.esp-toggle-label');
      if (label) label.textContent = userPaused ? 'Reanudar' : 'Pausar';
      toggle.setAttribute('aria-label', userPaused
        ? 'Reanudar el paso automático de especialidades'
        : 'Pausar el paso automático de especialidades');
    }

    function pauseByUser() {
      userPaused = true;
      row.classList.remove('playing');
      syncToggle();
    }

    function placeDot() {
      const tab = tabs[idx];
      const railTop = rail!.getBoundingClientRect().top;
      const r = tab.getBoundingClientRect();
      rail!.style.setProperty('--dot-y', `${r.top - railTop + r.height / 2}px`);
    }

    function restartProgress() {
      row.classList.remove('playing');
      void bar!.offsetWidth;
      if (!userPaused) row.classList.add('playing');
    }

    function syncPause() {
      row.classList.toggle('paused', !inView || hovering || focused);
    }

    function go(n: number, focusTab = false) {
      const next = (n + tabs.length) % tabs.length;
      if (next !== idx) {
        const prev = panels[idx];
        prev.classList.remove('active');
        prev.classList.add('leaving');
        window.setTimeout(() => prev.classList.remove('leaving'), 450);
        panels[next].classList.add('active');
        tabs[idx].classList.remove('active');
        tabs[idx].setAttribute('aria-selected', 'false');
        tabs[idx].tabIndex = -1;
        tabs[next].classList.add('active');
        tabs[next].setAttribute('aria-selected', 'true');
        tabs[next].tabIndex = 0;
        idx = next;
      }
      if (focusTab) tabs[idx].focus();
      placeDot();
      restartProgress();
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => { pauseByUser(); go(i); });
      tab.addEventListener('keydown', (e) => {
        const keys: Record<string, number> = { ArrowDown: idx + 1, ArrowRight: idx + 1, ArrowUp: idx - 1, ArrowLeft: idx - 1, Home: 0, End: tabs.length - 1 };
        if (!(e.key in keys)) return;
        e.preventDefault();
        pauseByUser();
        go(keys[e.key], true);
      });
    });

    bar.addEventListener('animationend', () => go(idx + 1));

    // Hover solo en dispositivos con ratón: en móvil un tap no debe dejarlo pausado.
    if (window.matchMedia('(hover: hover)').matches) {
      row.addEventListener('mouseenter', () => { hovering = true; syncPause(); });
      row.addEventListener('mouseleave', () => { hovering = false; syncPause(); });
    }
    // Solo el foco de teclado pausa; el foco que deja un clic/tap no.
    row.addEventListener('focusin', (e) => { focused = (e.target as Element).matches(':focus-visible'); syncPause(); });
    row.addEventListener('focusout', () => { focused = false; syncPause(); });

    // Swipe horizontal sobre la tarjeta (móvil).
    let startX = 0;
    let startY = 0;
    card.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
    }, { passive: true });
    card.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      const dy = e.changedTouches[0].clientY - startY;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) { pauseByUser(); go(dx < 0 ? idx + 1 : idx - 1); }
    });

    new IntersectionObserver((entries) => {
      inView = entries[0].isIntersecting;
      syncPause();
    }, { threshold: 0.35 }).observe(row);

    if (toggle && !reduced) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        if (userPaused) { userPaused = false; syncToggle(); go(idx + 1); }
        else pauseByUser();
      });
    }

    window.addEventListener('resize', placeDot);
    placeDot();
    syncToggle();
    syncPause();
    restartProgress();
  }

  document.addEventListener('astro:page-load', initEsp);
</script>
