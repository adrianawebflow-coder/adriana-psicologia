<style>
.footer {
  background: var(--color-bg-dark);
  padding: var(--space-16) var(--gutter) var(--space-8);
}

.footer-inner {
  max-width: var(--max-width);
  margin: 0 auto;
  display: grid;
  grid-template-columns: 1fr;
  gap: 2px;
  padding-bottom: var(--space-12);
  border-bottom: 1px solid rgba(245,242,234,0.08);
}

.foot-brand,
.foot-col {
  padding: 8px;
}

.footer-logo {
  display: flex;
  align-items: center;
  line-height: 0;
  text-decoration: none;
}
.footer-logo img {
  height: 34px;
  width: auto;
  display: block;
}

.foot-brand-meta {
  font-family: var(--font-sans);
  font-size: 12px;
  color: rgba(245,242,234,.85);
  margin: var(--space-4) 0 0;
}

.foot-brand-desc {
  font-family: var(--font-sans);
  font-size: 12px;
  line-height: 1.5;
  color: rgba(245,242,234,.6);
  margin: var(--space-4) 0 0;
  max-width: 26ch;
}

.footer-contact {
  margin-top: var(--space-5);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}
.footer-contact span {
  font-size: 12px;
  color: rgba(245,242,234,0.5);
}
.footer-contact a {
  font-size: 12px;
  color: rgba(245,242,234,0.5);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color var(--transition-base);
}
.footer-contact a:hover { color: var(--color-text-inverse); }

.footer-social {
  display: flex;
  gap: var(--space-4);
  margin-top: var(--space-4);
}
.footer-social a {
  font-size: 12px;
  color: rgba(245,242,234,0.45);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color var(--transition-base);
}
.footer-social a:hover { color: var(--color-moss-light); }

.foot-col {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.foot-col h4 {
  font-family: var(--font-sans);
  font-size: 14px;
  font-weight: 600;
  color: var(--color-text-inverse);
  margin: 8px 0 0;
}
.foot-col h4:first-child { margin-top: 0; }
.foot-col ul {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 6px;
}
.foot-col a {
  font-family: var(--font-sans);
  font-size: 12px;
  line-height: 1.5;
  color: rgba(245,242,234,.78);
  text-decoration: none;
  transition: color var(--transition-base);
}
.foot-col a:hover { color: var(--color-moss-light); }

.footer-bottom {
  max-width: var(--max-width);
  margin: var(--space-8) auto 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: var(--space-3);
  font-size: var(--fs-meta);
  color: rgba(245,242,234,0.35);
}
.footer-bottom-links { display: flex; gap: var(--space-6); }
.footer-bottom-links a {
  color: rgba(245,242,234,0.35);
  text-decoration: underline;
  text-underline-offset: 3px;
  transition: color var(--transition-base);
}
.footer-bottom-links a:hover { color: rgba(245,242,234,0.7); }

@media (min-width: 720px) {
  .footer-inner { grid-template-columns: 1fr 1fr 1fr; gap: 16px 40px; }
  .foot-brand { grid-column: 1 / -1; }
}
@media (min-width: 1080px) {
  .footer-inner { grid-template-columns: 1fr 1fr 1fr 232px; gap: 24px 40px; }
  .foot-brand { grid-column: auto; }
}
@media (max-width: 480px) {
  .footer-bottom { flex-direction: column; align-items: flex-start; }
}
</style>
