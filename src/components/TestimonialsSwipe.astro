---
import TestimonialsShapes from './shapes/TestimonialsShapes.astro';

// Reseñas de Google (5,0 / 5, 23 reseñas; extraídas el 30/09/2026), de la
// más reciente a la más antigua. Son fragmentos literales de cada reseña:
// lo omitido se marca con […] y solo se han corregido erratas evidentes.
const GOOGLE_RATING = '5,0';
const GOOGLE_REVIEWS_URL = 'https://share.google/zn7Rn80TOiNCbP351';

const reviews = [
  { name: 'Alba G.', detail: 'Paciente desde 2021', quote: 'Gracias Adriana por estar en mi proceso de recuperación en 2021, sin duda te recuerdo con mucho cariño en una etapa de mi vida bastante complicada. Eres una gran profesional […].' },
  { name: 'Marina S.', detail: 'En terapia desde 2025', quote: 'Adriana te hace sentir desde el principio como en casa […]. Tiene esa magia que hace de terapia un lugar seguro en el que poder abrirte, llorar o enfadarte. Ella no te juzga, te habla con cariño desde la verdad y te enseña a encontrar tu propio camino.' },
  { name: 'Blanca S.', detail: '4 años en terapia', quote: 'Desde el primer momento crea un lugar seguro en el que poder refugiarte cuando todo pesa. […] Desde que me guía en mi proceso me siento con la capacidad de poder abordar los distintos obstáculos que vayan surgiendo. Ha hecho posible ver la luz al final del túnel.' },
  { name: 'Monica J.', detail: 'Paciente', quote: 'Ir a terapia con Adriana ha sido de las mejores decisiones que he tomado en mi vida. […] Gracias a ella he podido trabajar muchos temas personales y entenderme mucho mejor. […] Para mí, conocer a Adriana ha sido un antes y un después.' },
  { name: 'Julián R.', detail: 'Paciente', quote: 'Adriana es una persona maravillosa y como profesional es la mejor. Destacaría ante todo que tiene muchísima paciencia y sobre todo dedicación. […] Te hace sentir seguro en todo momento ya que crea ese espacio de confianza tan necesario.' },
  { name: 'Olivia S.', detail: 'Paciente', quote: 'Adri tiene una forma de escuchar muy especial, te hace sentir realmente comprendida sin juzgarte en ningún momento. […] Gracias al proceso terapéutico con Adri siento que he ganado claridad, calma y una mayor comprensión de mí misma.' },
  { name: 'Marco F.', detail: 'Terapia individual, de pareja y familiar', quote: 'Adriana te hace sentir muy cómodo desde el primer momento. Su dulzura, empatía y sensibilidad hacen que la terapia se sienta como un lugar seguro donde poder mostrarte tal y como eres. Me ha ayudado personalmente, pero también con mi pareja y mi familia.' },
  { name: 'Marga R.', detail: 'Madre de una paciente', quote: 'Adriana lleva meses tratando a mi hija y le estaré eternamente agradecida porque está siendo un faro de luz en la oscuridad. Gracias a ella mi hija ha vuelto a sonreír […]. Con ella siempre he sentido que mi hija estaba en las mejores manos.' },
  { name: 'Adela M.', detail: 'Terapia de pareja', quote: 'Mi pareja y yo empezamos a acudir a terapia con Adriana en mayo, y encontrarla y confiar en ella ha sido la mejor decisión. […] Nos ha ayudado (y todavía nos sigue ayudando) a entendernos, a trabajar los aspectos de la comunicación en pareja y a tener las herramientas para poder resolver los conflictos.' },
  { name: 'Natalisestas', detail: 'Paciente desde 2024', quote: 'Voy a terapia con Adriana desde octubre de 2024. Es una gran profesional, con ella volví a confiar en la psicología y en la terapia […]. Es cercana, no juzga, escucha activamente a sus pacientes y genera de su consulta un entorno seguro en el cual todo fluye.' },
  { name: 'Alejandro L.', detail: 'Terapia de pareja e individual', quote: 'Mi pareja y yo encontramos inesperadamente a Adriana para poder solventar nuestros problemas de pareja hace más de un año […]. Es muy atenta y se nota que le encanta su profesión. […] Gracias a ella hemos podido asentar pilares fundamentales de nuestra relación y de nuestras vidas.' },
  { name: 'Ariadna', detail: 'Casi un año en terapia', quote: 'Estoy muy agradecida con Adriana. Gracias a su profesionalidad y empatía, me ha acompañado y ayudado durante casi un año en un proceso muy significativo para mí.' },
  { name: 'Jesus L.', detail: 'Unos 6 años en terapia', quote: 'Adriana es una profesional increíble, me trata desde hace unos 6 años y me ha ayudado muchísimo a sentirme más seguro en mi vida laboral y personal, soy mucho mejor persona y mucho más feliz desde que voy a sus sesiones.' },
  { name: 'Elenka V.', detail: '4 años en terapia', quote: 'Empecé terapia con Adri hace 4 años y solo tengo buenas palabras que decir. Desde el primer momento que estuve con ella tuve una conexión que pocas veces tengo con personas. […] Gracias a su escucha, consejos y atención he podido superar innumerables obstáculos.' },
  { name: 'Camila Y.', detail: 'Paciente desde 2021', quote: '¡Adri es la mejor! […] Con su ayuda, su paciencia y sus conocimientos conseguí salir de ahí. A día de hoy me sigue ayudando con otros temas pendientes que aún tengo. […] ¡La psicóloga que más recomiendo en este mundo!' },
  { name: 'Laura R.', detail: 'Años en terapia', quote: 'Llevo años en terapia con ella y ha resultado ser uno de los principales apoyos en mi proceso de recuperación y autoaprendizaje. […] Hay muy pocas profesionales con la dedicación y pasión de Adriana por ayudar significativamente a sus pacientes.' },
  { name: 'Lishuang G.', detail: 'Muchos años en terapia', quote: 'Adri lleva siendo mi psicóloga muchos años, es una gran profesional que te ayuda con todo lo que necesitas y está atenta de ti siempre que la necesites. Muchas gracias por cuidarme tan bien.' },
  { name: 'Cristina L.', detail: 'Paciente', quote: 'Sensibilidad, empatía y compromiso son las tres palabras con las que definiría a Adriana. Para mí es un regalo ser su paciente […]. Tiene un corazón que vale oro, solo hay que escucharla y dejarse tratar.' },
  { name: 'Celia C.', detail: 'Paciente desde 2021', quote: 'Adriana es una de esas personas a las que una vez conoces, no quieres olvidar jamás. Empecé en terapia con ella en 2021 y es de las mejores decisiones que he tomado nunca. […] Para mí, no es «mi psicóloga», para mí, es Adri.' },
  { name: 'Juan C.', detail: 'Padre de una paciente', quote: 'Adriana es una grandísima psicóloga que a mi hija la trató muy bien y la ayudó en poco tiempo a salir de un bache que tuvo en su vida. Es muy profesional y crea un buen ambiente a sus pacientes […].' },
  { name: 'Sandra B.', detail: 'Casi 3 años en terapia', quote: 'Adriana lleva en mi proceso casi tres años y he de decir que como psicóloga es de las mejores que he tenido. Desde el minuto uno crea un ambiente tranquilo y confortable para que puedas expresarte y abrirte sin miedo a las críticas y al juicio.' },
  { name: 'Almudena B.', detail: '6 años en terapia', quote: 'Desde el momento que empecé con Adriana hace 6 años, me sentí muy cómoda y encajamos a la perfección. Después de años de intentos fallidos con diferentes psicólogos, por fin he encontrado a alguien que marca la diferencia.' },
  { name: 'Sandra F.', detail: '2 años y medio en terapia', quote: 'Lleva dos años y medio acompañándome, para mí es la mejor psicóloga del mundo. Tiene muchísima empatía, te lo intenta poner fácil siempre […]. Siempre te va a hacer sentir querida y cuidada.' },
];

// El fondo de la card es verde musgo, así que los avatares alternan entre
// tonos que contrastan con él.
const AVATAR_COLORS = [
  'var(--color-clay)',
  'var(--color-moss-hover)',
  'var(--color-clay-hover)',
  'var(--color-bg-dark)',
];

const testimonials = reviews.map((r, i) => ({
  ...r,
  initials: r.name.split(/\s+/).map((w) => w[0]).join('').slice(0, 2),
  avatarColor: AVATAR_COLORS[i % AVATAR_COLORS.length],
}));
---

<section
  class="tsw-section"
  role="region"
  aria-label="Testimonios de pacientes"
  aria-roledescription="carrusel"
  id="testimonios"
>
  <TestimonialsShapes />

  <!-- Visually-hidden live region -->
  <div
    id="tswLive"
    aria-live="polite"
    aria-atomic="true"
    class="tsw-live"
  ></div>

  <div class="tsw-container">
    <h2 class="tsw-heading reveal">Lo que dicen mis pacientes</h2>
    <p class="tsw-rating reveal">
      <a href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener">
        <span class="tsw-rating-stars" aria-hidden="true">★★★★★</span>
        <span><strong>{GOOGLE_RATING}</strong> · {testimonials.length} reseñas en Google</span>
      </a>
    </p>

    <!-- Card stack -->
    <div class="tsw-stack-outer" id="tswOuter">
      <div class="tsw-stack" id="tswStack" style="perspective: 1000px">
        {testimonials.map((t, i) => (
          <article
            class="tsw-card"
            data-idx={String(i)}
            role="group"
            aria-label={`Testimonio de ${t.name}`}
            aria-hidden={i > 0 ? 'true' : 'false'}
          >
            <div class="tsw-stars" aria-label="5 estrellas">★★★★★</div>
            <blockquote class="tsw-quote">&ldquo;{t.quote}&rdquo;</blockquote>
            <footer class="tsw-author">
              <div class="tsw-avatar" aria-hidden="true" style={`background:${t.avatarColor}`}>{t.initials}</div>
              <div class="tsw-author-text">
                <span class="tsw-name">{t.name}</span>
                <span class="tsw-detail">{t.detail}</span>
              </div>
            </footer>
            <div class="tsw-rule" aria-hidden="true"></div>
            <a class="tsw-google" href={GOOGLE_REVIEWS_URL} target="_blank" rel="noopener" draggable="false" tabindex={i === 0 ? 0 : -1}>
              Reseña verificada de Google →
            </a>
          </article>
        ))}
      </div>
    </div>

    <!-- Controles: pausa (WCAG 2.2.2) + anterior/siguiente en mobile y
         puntos de 24px en desktop (WCAG 2.5.8). -->
    <div class="tsw-controls">
      <button class="tsw-ctrl tsw-toggle" id="tswToggle" type="button" aria-label="Pausar el paso automático de testimonios" hidden>
        <svg class="ico-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg class="ico-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.5-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5Z"/></svg>
      </button>
      <button class="tsw-ctrl tsw-step" id="tswPrev" type="button" aria-label="Testimonio anterior">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <p class="tsw-counter" aria-hidden="true"><span id="tswCount">1</span> / {testimonials.length}</p>
      <button class="tsw-ctrl tsw-step" id="tswNext" type="button" aria-label="Testimonio siguiente">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </button>
      <div class="tsw-dots" role="tablist" aria-label="Selector de testimonio">
        {testimonials.map((_, i) => (
          <button
            class={`tsw-dot${i === 0 ? ' active' : ''}`}
            type="button"
            role="tab"
            aria-selected={i === 0}
            aria-label={`Testimonio ${i + 1} de ${testimonials.length}`}
            data-idx={String(i)}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
/* ── Section ── */
.tsw-section {
  position: relative;
  background: var(--color-bg-soft);
  padding-top: var(--section-pad-top);
  padding-bottom: var(--section-pad-bottom);
  overflow: hidden;
}

.tsw-container {
  position: relative;
  z-index: 1;
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

.tsw-heading {
  font-family: var(--font-serif);
  font-size: var(--fs-h2);
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 var(--space-3);
  text-align: center;
}

.tsw-rating {
  display: flex;
  justify-content: center;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 0 0 var(--space-10);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  color: var(--color-text-secondary);
}
.tsw-rating a {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px;
  color: inherit;
  text-decoration: none;
  border-radius: 999px;
  padding: 2px 8px;
}
.tsw-rating a:hover span:last-child { text-decoration: underline; text-underline-offset: 3px; }
.tsw-rating a:focus-visible { outline: 2px solid var(--color-moss); outline-offset: 2px; }
.tsw-rating strong { color: var(--color-text-primary); font-weight: var(--fw-semi); }
.tsw-rating-stars { color: var(--color-gold); letter-spacing: 2px; }

/* ── Stack ── */
.tsw-stack-outer {
  cursor: grab;
  user-select: none;
  overflow: visible;
}
.tsw-stack-outer:active { cursor: grabbing; }

.tsw-stack {
  position: relative;
  /* height set by JS */
  min-height: 200px;
  overflow: visible;
}

/* ── Card base ── */
.tsw-card {
  --focus-ring: var(--focus-ring-on-dark);
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  margin-inline: auto;
  width: calc(100% - 48px);
  max-width: 480px;
  padding: var(--space-8);
  background: var(--color-moss);
  border: 1px solid rgba(245,242,234,0.07);
  border-radius: 16px;
  will-change: transform, opacity;
  backface-visibility: hidden;
  transform-style: preserve-3d;
  user-select: none;
  touch-action: pan-y;
  box-sizing: border-box;
  /* La altura la fija JS (updateHeight) igualándola a la card con más
     contenido, para que el stack no "baile" al cambiar de testimonio. */
  display: flex;
  flex-direction: column;
}

/* ── Card content ── */
.tsw-stars {
  display: block;
  color: #BDA165; /* oro aclarado: 3.0:1 sobre musgo (gráfico, 1.4.11) */
  letter-spacing: 3px;
  font-size: 13px;
  margin-bottom: var(--space-5);
}

.tsw-quote {
  flex: 1 0 auto;
  font-family: var(--font-serif);
  font-weight: var(--fw-light);
  font-style: italic;
  font-size: clamp(1rem, 2.5vw, 1.125rem);
  line-height: var(--lh-loose);
  color: rgba(245,242,234,0.90);
  margin: 0 0 var(--space-8);
}

.tsw-author {
  display: flex;
  align-items: center;
  gap: 12px;
}

.tsw-avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  /* background set per-testimonial via inline style */
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-sans);
  font-weight: 600;
  font-size: 14px;
  color: #fff;
  flex-shrink: 0;
  text-transform: uppercase;
}

.tsw-author-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.tsw-name {
  font-family: var(--font-sans);
  font-weight: 500;
  font-size: 14px;
  color: var(--color-text-inverse);
}

.tsw-detail {
  font-family: var(--font-sans);
  font-weight: 400;
  font-size: 12px;
  color: rgba(245,242,234,0.78); /* 4.9:1 sobre musgo */
}

.tsw-rule {
  margin-top: var(--space-6);
  border-top: 1px solid rgba(245,242,234,0.06);
  padding-top: var(--space-5);
}

.tsw-google {
  align-self: flex-start;
  text-decoration: none;
  font-family: var(--font-sans);
  font-size: 12px;
  color: var(--color-moss-soft); /* 5.1:1 sobre musgo */
  letter-spacing: 0.04em;
}
.tsw-google:hover { opacity: 1; text-decoration: underline; text-underline-offset: 3px; }
.tsw-google:focus-visible { outline: 2px solid var(--color-moss-light); outline-offset: 2px; border-radius: 4px; }

/* ── Controles ── */
.tsw-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
  margin-top: var(--space-8);
}
.tsw-ctrl {
  flex: 0 0 auto;
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  border: 1px solid var(--color-moss);
  background: var(--color-bg-base);
  color: var(--color-moss);
  cursor: pointer;
  transition: background 150ms ease, color 150ms ease;
}
.tsw-ctrl:hover { background: var(--color-moss); color: var(--color-text-inverse); }
.tsw-toggle .ico-play { display: none; }
.tsw-toggle.is-paused .ico-play { display: block; }
.tsw-toggle.is-paused .ico-pause { display: none; }
.tsw-counter {
  min-width: 64px;
  margin: 0;
  text-align: center;
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-variant-numeric: tabular-nums;
  color: var(--color-text-secondary);
}

/* Puntos: área táctil de 24×24 con el punto visual dentro (WCAG 2.5.8). En
   mobile, 23 puntos de 24px no caben: se usan anterior/siguiente. */
.tsw-dots { display: none; }
.tsw-dot {
  width: 24px;
  height: 24px;
  padding: 0;
  border: none;
  background: none;
  cursor: pointer;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}
.tsw-dot::before {
  content: '';
  width: 8px;
  height: 8px;
  border-radius: 4px;
  background: var(--color-text-muted); /* 5.6:1 sobre bg-soft */
  transition: width 300ms cubic-bezier(0.34, 1.56, 0.64, 1), background 200ms ease;
}
.tsw-dot:hover::before { background: var(--color-text-secondary); }
.tsw-dot.active::before { width: 22px; background: var(--color-moss); }

@media (min-width: 880px) {
  .tsw-step, .tsw-counter { display: none; }
  .tsw-dots { display: flex; align-items: center; }
}

/* ── Focus ring ── */
.tsw-stack-outer:focus-visible {
  outline: 3px solid var(--color-moss);
  outline-offset: 4px;
  border-radius: 16px;
}

/* ── Visually hidden live region ── */
.tsw-live {
  position: absolute;
  width: 1px; height: 1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
}

/* ── Reduced motion: opacity-only crossfade ── */
@media (prefers-reduced-motion: reduce) {
  .tsw-card {
    transition: opacity 200ms ease !important;
    transform: none !important;
    filter: none !important;
  }
  .tsw-card:not([data-state="front"]) {
    pointer-events: none;
  }
  .tsw-dot::before { transition: none !important; }
}
</style>

<script>
// @ts-nocheck — vanilla browser JS, strict TS types no aplican aquí

// Esta sección no usa transition:persist, así que tras una navegación SPA
// del ClientRouter el <script> se inserta de nuevo pero el navegador no lo
// ejecuta salvo que reaccionemos a astro:page-load (carga inicial y cada
// navegación posterior). Sin esto, initAll() nunca corre en la vuelta a
// Home y las tarjetas se quedan sin transformar ni altura calculada.
document.addEventListener('astro:page-load', () => {
  /* ─── Constants ─────────────────────────────────── */
  const THRESHOLD_RATIO  = 0.38;
  const VEL_THRESHOLD    = 0.5;     // px/ms
  const AUTOPLAY_MS      = 6000;
  const AUTOPLAY_RESUME_DELAY = 1000;

  /* ─── Elements ──────────────────────────────────── */
  const outer   = document.getElementById('tswOuter');
  const stack   = document.getElementById('tswStack');
  const liveEl  = document.getElementById('tswLive');
  if (!outer || !stack) return;

  const cards   = Array.from(stack.querySelectorAll('.tsw-card'));
  const dotBtns = Array.from(document.querySelectorAll('.tsw-dot'));
  const toggle  = document.getElementById('tswToggle');
  const prevBtn = document.getElementById('tswPrev');
  const nextBtn = document.getElementById('tswNext');
  const countEl = document.getElementById('tswCount');
  const N       = cards.length;

  // Los enlaces de las cards ocultas no deben recibir foco: se sincroniza su
  // tabindex con el aria-hidden de la card, cambie como cambie (drag, dots,
  // teclado, autoplay o modo reduced-motion).
  const syncLink = (c) => {
    const a = c.querySelector('.tsw-google');
    if (a) a.tabIndex = c.getAttribute('aria-hidden') === 'true' ? -1 : 0;
  };
  const linkObserver = new MutationObserver((ms) => ms.forEach((m) => syncLink(m.target)));
  cards.forEach((c) => {
    syncLink(c);
    linkObserver.observe(c, { attributes: true, attributeFilter: ['aria-hidden'] });
  });

  // Si el gesto ha sido un arrastre, el click que lo cierra no debe abrir
  // el enlace de la card.
  let didDrag = false;
  outer.addEventListener('pointerdown', () => { didDrag = false; }, { capture: true, passive: true });
  outer.addEventListener('pointerup', () => { if (didDrag) setTimeout(() => { didDrag = false; }, 0); }, { capture: true });
  outer.addEventListener('click', (e) => {
    if (!didDrag) return;
    didDrag = false;
    e.preventDefault();
    e.stopPropagation();
  }, true);

  /* ─── State ─────────────────────────────────────── */
  let activeIdx   = 0;
  let isAnimating = false;
  let isDragging  = false;
  let dragX       = 0;
  let dragStartX  = 0;
  let dragStartY  = 0;
  let isHoriz     = null;   // null = undecided, true/false
  let velBuf      = [];     // [{x, t}]
  let ptrId       = null;
  let rafId       = null;
  let autoTimer   = null;
  let resumeTimer = null;
  let cardW       = 0;
  let threshold   = 0;

  /* ─── Reduced-motion flag ────────────────────────── */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ─── Helpers ───────────────────────────────────── */
  function wrap(i) { return ((i % N) + N) % N; }
  function rel(i)  { return wrap(i - activeIdx); }

  const STATES = {
    front:  { y: 0,   s: 1,    o: 1,    blur: 0, z: 3, shadow: '0 24px 64px rgba(26,33,24,0.22)', pe: true  },
    middle: { y: -12, s: 0.96, o: 0.75, blur: 1, z: 2, shadow: '0 12px 32px rgba(26,33,24,0.14)', pe: false },
    back:   { y: -22, s: 0.92, o: 0.45, blur: 2, z: 1, shadow: '0 6px 16px rgba(26,33,24,0.08)',  pe: false },
    hidden: { y: -30, s: 0.88, o: 0,    blur: 0, z: 0, shadow: 'none',                             pe: false },
  };

  function stateFor(cardIdx) {
    const r = rel(cardIdx);
    return r === 0 ? 'front' : r === 1 ? 'middle' : r === 2 ? 'back' : 'hidden';
  }

  function applyNow(el, p) {
    el.style.transform    = `translateX(${p.x ?? 0}px) translateY(${p.y}px) scale(${p.s})`;
    el.style.opacity      = p.o;
    el.style.filter       = p.blur ? `blur(${p.blur}px)` : '';
    el.style.boxShadow    = p.shadow;
    el.style.zIndex       = p.z;
    el.style.pointerEvents = p.pe ? 'auto' : 'none';
    el.setAttribute('aria-hidden', p.pe ? 'false' : 'true');
  }

  function updateMeasurements() {
    cardW     = cards[activeIdx].offsetWidth || 400;
    threshold = cardW * THRESHOLD_RATIO;
  }

  // Iguala todas las cards a la altura de la que tenga más contenido, para
  // que el stack no cambie de tamaño (ni el resto de la página "baile") al
  // pasar de un testimonio corto a uno largo.
  function updateHeight() {
    let maxH = 0;
    cards.forEach((c) => {
      c.style.height = 'auto';
      maxH = Math.max(maxH, c.offsetHeight);
    });
    cards.forEach((c) => { c.style.height = maxH + 'px'; });
    stack.style.height = (maxH + 22) + 'px';
  }

  function updateDots(idx) {
    if (countEl) countEl.textContent = String(idx + 1);
    dotBtns.forEach((d, i) => {
      const active = i === idx;
      d.classList.toggle('active', active);
      d.setAttribute('aria-selected', String(active));
    });
  }

  function announce(idx) {
    const c = cards[idx];
    if (liveEl && c) {
      const name = c.querySelector('.tsw-name')?.textContent ?? '';
      liveEl.textContent = `Testimonio ${idx + 1} de ${N} — ${name}`;
    }
    cards.forEach((c, i) => c.setAttribute('aria-hidden', String(i !== idx)));
  }

  /* ─── Init ──────────────────────────────────────── */
  function initAll() {
    cards.forEach((c, i) => {
      const st = STATES[stateFor(i)];
      applyNow(c, st);
    });
    updateMeasurements();
    updateHeight();
    updateDots(0);
    announce(0);
  }

  /* ─── Drag ──────────────────────────────────────── */
  function onPtrDown(e) {
    if (isAnimating || e.button !== 0) return;

    // Clear any CSS transition so drag applyDrag() is instant (not eased).
    const fc = cards[activeIdx];
    fc.style.transition = '';
    tiltCard = null;

    isDragging  = true;
    dragX       = 0;
    dragStartX  = e.clientX;
    dragStartY  = e.clientY;
    isHoriz     = null;
    velBuf      = [{ x: e.clientX, t: e.timeStamp }];

    // La captura del puntero se pide al confirmar el arrastre horizontal
    // (onPtrMove): si se pidiera aquí, un simple clic acabaría en la card y
    // no en el enlace «Reseña verificada de Google».
    ptrId = e.pointerId;
    document.body.style.cursor = 'grabbing';
    stopAutoplay();
  }

  function onPtrMove(e) {
    if (!isDragging) return;

    const dx = e.clientX - dragStartX;
    const dy = e.clientY - dragStartY;

    // Determine axis once
    if (isHoriz === null) {
      if (Math.abs(dx) > 4 || Math.abs(dy) > 4) {
        isHoriz = Math.abs(dx) >= Math.abs(dy);
        if (isHoriz) {
          didDrag = true;
          try { cards[activeIdx].setPointerCapture(ptrId); } catch {}
        }
        if (isHoriz) cards[activeIdx].style.touchAction = 'none';
      }
      return;
    }
    if (!isHoriz) return;
    e.preventDefault();

    dragX = dx;

    // Velocity buffer
    velBuf.push({ x: e.clientX, t: e.timeStamp });
    if (velBuf.length > 3) velBuf.shift();

    // Throttle via RAF
    if (rafId) cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(applyDrag);
  }

  function applyDrag() {
    const progress  = Math.min(Math.abs(dragX) / threshold, 1);
    const rotation  = (dragX / cardW) * 8;
    const scaleUp   = 1 + (Math.abs(dragX) / cardW) * 0.02;
    const shadowA   = (0.22 + progress * 0.13).toFixed(3);

    // Front card
    const fc = cards[activeIdx];
    fc.style.transform = `translateX(${dragX}px) translateY(0px) rotate(${rotation}deg) scale(${scaleUp})`;
    fc.style.boxShadow = `0 ${Math.round(24 + progress * 8)}px ${Math.round(64 + progress * 16)}px rgba(26,33,24,${shadowA})`;

    // Middle card
    const mc = cards[wrap(activeIdx + 1)];
    const mS = 0.96 + progress * 0.04;
    const mO = 0.75 + progress * 0.25;
    const mY = -12  + progress * 12;
    mc.style.transform = `translateX(0px) translateY(${mY}px) scale(${mS})`;
    mc.style.opacity   = String(mO);
    mc.style.filter    = `blur(${(1 - progress).toFixed(2)}px)`;

    // Back card
    const bc = cards[wrap(activeIdx + 2)];
    const bS = 0.92 + progress * 0.03;
    const bO = 0.45 + progress * 0.20;
    const bY = -22  + progress * 8;
    bc.style.transform = `translateX(0px) translateY(${bY}px) scale(${bS})`;
    bc.style.opacity   = String(bO);
  }

  function getVelocity() {
    if (velBuf.length < 2) return 0;
    const a = velBuf[0], b = velBuf[velBuf.length - 1];
    const dt = b.t - a.t;
    return dt > 0 ? Math.abs(b.x - a.x) / dt : 0;
  }

  function onPtrUp(e) {
    if (!isDragging) return;
    isDragging = false;
    if (rafId) cancelAnimationFrame(rafId);

    document.body.style.cursor = '';
    cards[activeIdx].style.touchAction = 'pan-y';

    const velocity = getVelocity();
    const commit   = Math.abs(dragX) > threshold || velocity > VEL_THRESHOLD;

    if (commit && !isAnimating) {
      pauseByUser();
      commitSwipe(dragX > 0 ? 'right' : 'left');
    } else {
      snapBack();
    }

    dragX = 0;
  }

  /* ─── CSS transition helpers ────────────────────── */
  // Pure CSS transitions — avoids WAAPI (Motion One) fill-mode conflicts
  // that prevent style.transform from being overridable during next drag.
  const T_EXIT    = 'transform 380ms cubic-bezier(0.32,0,0.67,0), opacity 380ms cubic-bezier(0.32,0,0.67,0)';
  const T_PROMOTE = 'transform 420ms cubic-bezier(0.22,1,0.36,1), opacity 420ms ease-out, filter 420ms ease-out';
  const T_ENTER   = 'transform 420ms cubic-bezier(0.34,1.56,0.64,1), opacity 400ms ease-out, filter 400ms ease-out';
  const T_SNAP    = 'transform 480ms cubic-bezier(0.34,1.56,0.64,1), opacity 480ms ease-out, filter 480ms ease-out';

  function clearTx(el) { el.style.transition = 'none'; }
  function reflow(el)  { void el.offsetHeight; }          // force layout flush

  /* ─── Commit Swipe ──────────────────────────────── */
  function commitSwipe(dir) {
    isAnimating = true;

    const flyX = `${(dir === 'right' ? 1 : -1) * 120}vw`;
    const flyR = dir === 'right' ? '14deg' : '-14deg';

    const iFC  = activeIdx;
    const iMC  = wrap(activeIdx + 1);
    const iBK  = wrap(activeIdx + 2);
    const iNBK = wrap(activeIdx + 3);

    // Advance state immediately
    activeIdx = iMC;
    updateDots(activeIdx);
    announce(activeIdx);

    const fc  = cards[iFC];
    const mc  = cards[iMC];
    const bk  = cards[iBK];
    const nbk = cards[iNBK];

    // Snap entering-back card to start position with NO transition
    clearTx(nbk);
    nbk.style.transform     = 'translateX(0px) translateY(-30px) scale(0.88)';
    nbk.style.opacity       = '0';
    nbk.style.filter        = '';
    nbk.style.zIndex        = '1';
    nbk.style.pointerEvents = 'none';
    nbk.setAttribute('aria-hidden', 'true');

    // Force reflow so the browser registers the start state before transitioning
    reflow(fc); reflow(mc); reflow(bk); reflow(nbk);

    // ① Front flies out
    fc.style.zIndex    = '4';
    fc.style.transition = T_EXIT;
    fc.style.transform = `translateX(${flyX}) translateY(0px) rotate(${flyR}) scale(1)`;
    fc.style.opacity   = '0';

    // ② Middle → Front
    mc.style.zIndex     = '3';
    mc.style.transition = T_PROMOTE;
    mc.style.transform  = 'translateX(0px) translateY(0px) scale(1)';
    mc.style.opacity    = '1';
    mc.style.filter     = 'blur(0px)';

    // ③ Back → Middle (40ms delay via transition-delay)
    bk.style.zIndex     = '2';
    bk.style.transition = `transform 420ms 40ms cubic-bezier(0.22,1,0.36,1), opacity 420ms 40ms ease-out, filter 420ms 40ms ease-out`;
    bk.style.transform  = 'translateX(0px) translateY(-12px) scale(0.96)';
    bk.style.opacity    = '0.75';
    bk.style.filter     = 'blur(1px)';

    // ④ New back enters (80ms later so it appears after the stack has moved)
    setTimeout(() => {
      nbk.style.transition = T_ENTER;
      nbk.style.transform  = 'translateX(0px) translateY(-22px) scale(0.92)';
      nbk.style.opacity    = '0.45';
      nbk.style.filter     = 'blur(2px)';
    }, 80);

    // Cleanup: clear all transitions so next drag isn't throttled by CSS
    setTimeout(() => {
      // Hide old front, no transition
      clearTx(fc);
      fc.style.transform     = 'translateX(0px) translateY(-30px) scale(0.88)';
      fc.style.opacity       = '0';
      fc.style.filter        = '';
      fc.style.zIndex        = '0';
      fc.style.pointerEvents = 'none';
      fc.setAttribute('aria-hidden', 'true');

      // Clear transitions on every card so drag applyDrag() runs instantly
      cards.forEach((c, i) => {
        c.style.transition    = '';
        const st = STATES[stateFor(i)];
        c.style.zIndex        = st.z;
        c.style.pointerEvents = st.pe ? 'auto' : 'none';
        c.setAttribute('aria-hidden', st.pe ? 'false' : 'true');
      });

      updateHeight();
      isAnimating = false;
      scheduleResume();
    }, 480);
  }

  /* ─── Snap Back ─────────────────────────────────── */
  function snapBack() {
    isAnimating = true;

    const fc = cards[activeIdx];
    fc.style.transition = T_SNAP;
    fc.style.transform  = 'translateX(0px) translateY(0px) rotate(0deg) scale(1)';
    fc.style.boxShadow  = STATES.front.shadow;

    const mc = cards[wrap(activeIdx + 1)];
    mc.style.transition = T_SNAP;
    mc.style.transform  = 'translateX(0px) translateY(-12px) scale(0.96)';
    mc.style.opacity    = '0.75';
    mc.style.filter     = 'blur(1px)';

    const bc = cards[wrap(activeIdx + 2)];
    bc.style.transition = T_SNAP;
    bc.style.transform  = 'translateX(0px) translateY(-22px) scale(0.92)';
    bc.style.opacity    = '0.45';
    bc.style.filter     = 'blur(2px)';

    setTimeout(() => {
      // Clear transitions before next drag
      cards.forEach(c => { c.style.transition = ''; });
      isAnimating = false;
      scheduleResume();
    }, 500);
  }

  /* ─── Programmatic advance (autoplay / keyboard) ── */
  function advance() {
    if (isAnimating) return;
    dragX = 0;
    commitSwipe('left');
  }

  function retreat() {
    if (isAnimating) return;
    dragX = 0;
    commitSwipe('right');
  }

  function goTo(idx) {
    if (idx === activeIdx || isAnimating) return;
    if (wrap(idx - activeIdx) === 1) { advance(); return; }

    // Instant jump for non-adjacent
    isAnimating = true;
    activeIdx   = idx;
    cards.forEach((c, i) => {
      applyNow(c, { ...STATES[stateFor(i)] });
      c.style.filter = '';
    });
    updateDots(idx);
    announce(idx);
    updateHeight();
    requestAnimationFrame(() => { isAnimating = false; });
  }

  /* ─── Hover tilt (desktop only) ─────────────────── */
  // Track which card last received the tilt so onMouseLeave only resets it.
  let tiltCard = null;

  function onMouseMove(e) {
    if (isDragging || reduced) return;
    const fc   = cards[activeIdx];
    const rect = fc.getBoundingClientRect();
    const cx   = rect.left + rect.width  / 2;
    const cy   = rect.top  + rect.height / 2;
    const rx   = ((e.clientY - cy) / rect.height) * -4;
    const ry   = ((e.clientX - cx) / rect.width)  *  4;
    fc.style.transform  = `translateX(0px) translateY(0px) rotateX(${rx}deg) rotateY(${ry}deg) translateZ(8px) scale(1)`;
    fc.style.transition = 'transform 180ms ease-out';
    tiltCard = fc;
  }

  function onMouseLeave() {
    // Only reset the card that actually had tilt applied — not cards[activeIdx]
    // generically, which could be a different card after a swipe.
    const target = tiltCard;
    if (!target) return;
    tiltCard = null;
    target.style.transition = 'transform 300ms ease-out';
    target.style.transform  = 'translateX(0px) translateY(0px) scale(1)';
    setTimeout(() => { target.style.transition = ''; }, 310);
  }

  /* ─── Autoplay ───────────────────────────────────── */
  // userPaused: la persona ha pulsado pausa o ha interactuado con el
  // carrusel. A partir de ahí el autoplay no vuelve solo (WCAG 2.2.2).
  let userPaused = reduced;

  function syncToggle() {
    if (!toggle) return;
    toggle.classList.toggle('is-paused', userPaused);
    toggle.setAttribute('aria-label', userPaused
      ? 'Reanudar el paso automático de testimonios'
      : 'Pausar el paso automático de testimonios');
    // Mientras pasa solo, no se anuncia cada cambio (sería una interrupción
    // cada 6 s); cuando lo controla la persona, sí.
    liveEl?.setAttribute('aria-live', userPaused ? 'polite' : 'off');
  }

  function pauseByUser() {
    userPaused = true;
    stopAutoplay();
    syncToggle();
  }

  function startAutoplay(interval = AUTOPLAY_MS) {
    stopAutoplay();
    if (userPaused) return;
    autoTimer = setInterval(advance, interval);
  }

  function stopAutoplay() {
    clearInterval(autoTimer);
    autoTimer = null;
    clearTimeout(resumeTimer);
    resumeTimer = null;
  }

  function scheduleResume() {
    clearTimeout(resumeTimer);
    if (userPaused) return;
    resumeTimer = setTimeout(() => startAutoplay(), AUTOPLAY_RESUME_DELAY);
  }

  /* ─── Reduced-motion: opacity crossfade only ──────── */
  function initReduced() {
    cards.forEach((c, i) => {
      c.style.position = 'absolute';
      c.style.bottom   = '0';
      c.style.left = c.style.right = '0';
      c.style.margin   = 'auto';
      c.style.opacity  = i === 0 ? '1' : '0';
      c.style.zIndex   = i === 0 ? '3' : '0';
      c.style.pointerEvents = i === 0 ? 'auto' : 'none';
    });
    updateHeight();
    updateDots(0);
    announce(0);
    syncToggle();

    // Sin autoplay con movimiento reducido: no se muestra el botón de pausa.
    function show(i) {
      i = wrap(i);
      cards[activeIdx].style.opacity = '0';
      cards[activeIdx].style.pointerEvents = 'none';
      cards[activeIdx].style.zIndex = '0';
      cards[activeIdx].setAttribute('aria-hidden', 'true');
      activeIdx = i;
      cards[i].style.opacity = '1';
      cards[i].style.pointerEvents = 'auto';
      cards[i].style.zIndex = '3';
      cards[i].setAttribute('aria-hidden', 'false');
      updateDots(i);
      announce(i);
    }
    dotBtns.forEach((d, i) => d.addEventListener('click', () => show(i)));
    prevBtn?.addEventListener('click', () => show(activeIdx - 1));
    nextBtn?.addEventListener('click', () => show(activeIdx + 1));
  }

  /* ─── Wire Events ────────────────────────────────── */
  function wireEvents() {
    // Pointer drag
    outer.addEventListener('pointerdown',   onPtrDown,  { passive: true });
    outer.addEventListener('pointermove',   onPtrMove,  { passive: false });
    outer.addEventListener('pointerup',     onPtrUp);
    outer.addEventListener('pointercancel', onPtrUp);

    // Hover tilt (desktop)
    const matchDesktop = window.matchMedia('(pointer: fine)');
    if (matchDesktop.matches) {
      cards[activeIdx]?.addEventListener('mousemove', onMouseMove);
      outer.addEventListener('mouseleave', onMouseLeave);
    }

    // Cursor
    outer.addEventListener('pointerenter', () => { if (!isDragging) document.body.style.cursor = 'grab'; });
    outer.addEventListener('pointerleave', () => { document.body.style.cursor = ''; });

    // Autoplay pause/resume
    outer.addEventListener('pointerenter', stopAutoplay);
    outer.addEventListener('pointerleave', () => scheduleResume());
    outer.addEventListener('focus', stopAutoplay, { capture: true });
    outer.addEventListener('blur',  () => scheduleResume(), { capture: true });

    // Dots
    dotBtns.forEach((d, i) => {
      d.addEventListener('click', () => { pauseByUser(); goTo(i); });
    });

    // Anterior / siguiente (mobile)
    prevBtn?.addEventListener('click', () => { pauseByUser(); retreat(); });
    nextBtn?.addEventListener('click', () => { pauseByUser(); advance(); });

    // Pausa / reanudar
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => {
        if (userPaused) { userPaused = false; syncToggle(); advance(); startAutoplay(); }
        else pauseByUser();
      });
    }

    // Keyboard
    outer.setAttribute('tabindex', '0');
    outer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        pauseByUser();
        e.key === 'ArrowRight' ? advance() : retreat();
      }
      if (e.key === 'Escape') {
        document.querySelector('.tsw-heading')?.focus();
      }
    });

    // Resize
    let rTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(rTimer);
      rTimer = setTimeout(() => { updateMeasurements(); updateHeight(); }, 150);
    });
  }

  /* ─── Bootstrap ─────────────────────────────────── */
  if (reduced) {
    initReduced();
  } else {
    initAll();
    wireEvents();
    syncToggle();
    startAutoplay();
  }

  // Antes de salir de la página (siguiente navegación SPA), para el
  // autoplay: si no lo hacemos, el setInterval de esta instancia sigue
  // vivo indefinidamente incluso tras dejar Home, acumulándose con el de
  // cada visita posterior.
  document.addEventListener('astro:before-swap', stopAutoplay, { once: true });
});
</script>
