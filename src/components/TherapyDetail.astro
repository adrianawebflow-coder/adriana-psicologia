}
.other-card .chev {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: var(--color-moss-soft);
  color: var(--color-moss);
  display: grid;
  place-items: center;
  font-size: var(--fs-body-sm);
}
.other-card:hover .chev {
  background: var(--color-moss);
  color: #fff;
}

@media (min-width: 1000px) {
  .therapy-hero { padding: 60px 40px; }
  .therapy-hero-inner { flex-direction: row; gap: 64px; }
  .therapy-hero-inner > div { flex: 1 1 0; }
  .therapy-hero h1 { font-size: 34px; }

  .therapy-info { padding: 60px 135px 100px; }
  .info-columns { flex-direction: row; align-items: flex-start; gap: 40px; }
  .info-column { flex: 1 1 0; }

  .therapy-gallery-inner { flex-direction: row; align-items: stretch; }
  .gallery-photo { flex: 1 1 0; height: auto; min-height: 475px; }
  .gallery-arrow { display: flex; }
  .location-panel {
    flex: 0 0 570px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 32px 40px 32px;
    justify-content: center;
  }

  .other-services { padding: 60px 135px; }
  .other-grid { flex-direction: row; }
  .other-card { flex: 1 1 0; }
}

/* 1280–1399px: therapy-gallery se queda en 1280px (valor por defecto);
   el resto de secciones mantiene 1010px (también valor por defecto,
   sin necesidad de override aquí). */

/* 1400–1920px: todas las secciones, incluida therapy-gallery, a 1280px.
   therapy-info y other-services usan 135px de padding lateral fijo, que
   por debajo de ~1550px les impide alcanzar 1280px de ancho real; se
   reduce aquí para que max-width sea lo único que las limite. */
@media (min-width: 1400px) and (max-width: 1920px) {
  .therapy-hero-inner,
  .therapy-info-inner,
  .other-services-inner {
    max-width: 1280px;
  }
  .therapy-info,
  .other-services {
    padding-left: 40px;
    padding-right: 40px;
  }
}

/* > 1920px: todas las secciones, incluida therapy-gallery, a 1010px */
@media (min-width: 1921px) {
  .therapy-hero-inner,
  .therapy-info-inner,
  .therapy-gallery-inner,
  .other-services-inner {
    max-width: 1010px;
  }
}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const galleryEl = document.getElementById('gallery');
    const trackEl = document.getElementById('galleryTrack');
    const dotsWrap = document.getElementById('galleryDots');
    if (!galleryEl || !trackEl || !dotsWrap) return;
    const gallery = galleryEl;
    const track = trackEl;

    const slides = Array.from(track.children) as HTMLElement[];
    if (slides.length <= 1) return;

    dotsWrap.innerHTML = '';
    let idx = 0;
    let dx = 0;

    slides.forEach((_, i) => {
      const dot = document.createElement('button');
      dot.type = 'button';
      dot.setAttribute('role', 'tab');
      dot.setAttribute('aria-label', `Foto ${i + 1}`);
      dot.addEventListener('click', () => go(i));
      dotsWrap.appendChild(dot);
    });
    const dots = Array.from(dotsWrap.children) as HTMLElement[];

    function place(offset: number) {
      track.style.transform = `translateX(calc(${-idx * 100}% + ${offset}px))`;
    }

    function go(n: number) {
      idx = (n + slides.length) % slides.length;
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === idx)));
      place(0);
    }

    document.getElementById('galleryNext')?.addEventListener('click', () => go(idx + 1));
    document.getElementById('galleryPrev')?.addEventListener('click', () => go(idx - 1));

    const DRAG_THRESHOLD = 60;
    let startX = 0;
    let startY = 0;
    let dragging = false;
    let axisLocked: 'x' | 'y' | null = null;

    gallery.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      startX = t.clientX;
      startY = t.clientY;
      dx = 0;
      dragging = true;
      axisLocked = null;
      track.classList.add('dragging');
    }, { passive: true });

    gallery.addEventListener('touchmove', (e) => {
      if (!dragging) return;
      const t = e.touches[0];
      dx = t.clientX - startX;
      const dy = t.clientY - startY;
      if (!axisLocked) axisLocked = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
      if (axisLocked === 'x') place(dx);
    }, { passive: true });

    function release() {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('dragging');
      if (axisLocked === 'x' && Math.abs(dx) >= DRAG_THRESHOLD) {
        go(dx < 0 ? idx + 1 : idx - 1);
      } else {
        place(0);
      }
    }
    gallery.addEventListener('touchend', release);
    gallery.addEventListener('touchcancel', release);

    window.addEventListener('resize', () => place(0));

    go(0);
  });
</script>
