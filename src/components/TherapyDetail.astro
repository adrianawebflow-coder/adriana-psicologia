---
import fs from 'node:fs';
import path from 'node:path';

interface OtherService {
  tag: string;
  title: string;
  desc: string;
  href: string;
}

interface SectionListItem {
  label: string;
  text: string;
}

interface Props {
  title: string;
  lede: string;
  sectionTitle: string;
  sectionDesc: string;
  sectionList?: SectionListItem[];
  price: string;
  bono: string;
  otherServices: OtherService[];
}

const { title, lede, sectionTitle, sectionDesc, sectionList, price, bono, otherServices } = Astro.props;

const CALENDLY_URL = 'https://calendly.com/adrianapsicologia/15-20min';

const despachoDir = path.join(process.cwd(), 'public/images/despacho');
const despachoImages = fs
  .readdirSync(despachoDir)
  .filter((file) => /\.(webp|jpe?g|png)$/i.test(file))
  .sort()
  .map((file) => `/images/despacho/${file}`);
---

<section class="therapy-hero">
  <div class="therapy-hero-inner">
    <div>
      <h1 transition:name="hero-title">{title}</h1>
      <p class="lede">{lede}</p>
    </div>
    <div>
      <h2>{sectionTitle}</h2>
      <p class="desc">{sectionDesc}</p>
      {sectionList && (
        <ul class="section-list">
          {sectionList.map((item) => (
            <li><b>{item.label}</b>: {item.text}</li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<section class="therapy-info">
  <div class="therapy-info-inner">
    <h2 class="info-heading reveal">Información de la terapia</h2>
    <p class="info-lede reveal"><b>Sesión de evaluación:</b> es la primera sesión, en la que el terapeuta evalúa el motivo de consulta, recoge la historia del paciente y expone las condiciones del tratamiento. Por su parte, el paciente evalúa las habilidades del terapeuta para decidir si encaja con lo que necesita. La evaluación tiene una duración de 40–45 minutos y será gratuita en caso de iniciar el tratamiento.</p>

    <div class="info-columns">
      <div class="info-column">
        <h3 class="info-heading reveal">Normativa terapéutica</h3>
        <p class="info-lede reveal">El autocuidado comienza con el compromiso con tu salud.</p>
        <div class="info-grid">
          <div class="info-card reveal">
            <h4>Organización</h4>
            <ul class="info-card-list">
              <li>Las citas canceladas con menos de 24h de antelación conllevarán el cobro del 100% del importe de la sesión.</li>
              <li>El proceso de terapia quedará suspendido en caso de cancelaciones reiteradas por parte del paciente.</li>
            </ul>
          </div>
          <div class="info-card reveal">
            <h4>Privacidad</h4>
            <ul class="info-card-list">
              <li>Se recomienda el uso de auriculares y evitar conexiones de red públicas.</li>
              <li>En caso de que el espacio no asegure el derecho a la intimidad del paciente, el profesional se reserva el derecho a paralizar la sesión y reubicar la cita.</li>
            </ul>
          </div>
          <div class="info-card reveal">
            <h4>Puntualidad</h4>
            <ul class="info-card-list">
              <li>Se ofrece un margen de flexibilidad de 20 minutos, tras los cuales la sesión quedará cancelada con su correspondiente coste.</li>
              <li>Se requiere flexibilidad para las ocasiones en las que el terapeuta pueda alargarse con un paciente anterior y generar un retraso en las consultas siguientes.</li>
            </ul>
          </div>
        </div>
      </div>

      <div class="info-column">
        <h3 class="info-heading reveal">Modalidad</h3>
        <div class="modalidad-card reveal">
          <div class="modalidad-item">
            <h4>Presencial</h4>
            <p>Entorno cómodo y seguro para trabajar cara a cara en el despacho en Madrid.</p>
          </div>
          <div class="modalidad-item">
            <h4>Online</h4>
            <p>Acceso a la terapia desde tu hogar, a través de plataformas de telepsicología.</p>
          </div>
          <div class="modalidad-item">
            <h4>Mixto</h4>
            <p>Combinación de sesiones presenciales y online según la necesidad del paciente.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="therapy-gallery">
 <div class="therapy-gallery-inner">
  <div class="gallery-photo reveal" id="gallery">
    <div class="gallery-track" id="galleryTrack">
      {despachoImages.map((src, i) => (
        <div class="gallery-slide">
          <img
            src={src}
            alt={`Despacho de Adriana Psicología ${i + 1}`}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        </div>
      ))}
    </div>

    <div class="gallery-dots" id="galleryDots" role="tablist" aria-label="Fotos del despacho"></div>
    <button class="gallery-arrow prev" id="galleryPrev" type="button" aria-label="Foto anterior">
      <svg width="9" height="16" viewBox="0 0 7 12" fill="none" aria-hidden="true">
        <path d="M6 1L1 6l5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <button class="gallery-arrow next" id="galleryNext" type="button" aria-label="Siguiente foto">
      <svg width="9" height="16" viewBox="0 0 7 12" fill="none" aria-hidden="true">
        <path d="M1 1l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>

  <div class="location-panel reveal">
    <div class="panel-card">
      <h3>📍 Despacho en Manoteras, Madrid</h3>
      <ul class="location-list">
        <li><b>Metro</b>: Línea 4 – Manoteras (5 min) · Línea 1 – Pinar de Chamartín (15 min).</li>
        <li><b>Cercanías</b>: Fuente de la Mora, líneas C1, C2, C7 y C10 (15 min andando).</li>
        <li><b>Bus</b>: 129, 29, 7 · Paradas Alicún y Almanzora.</li>
        <li><b>Parking</b>: Gratuito en calles cercanas, sin parquímetro.</li>
      </ul>
    </div>

    <div class="panel-card">
      <p class="price-label">Precio</p>
      <p class="price-value">{price}</p>
    </div>

    <div class="panel-card bono-card">
      <p class="bono-title">
        <span class="badge-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
            <path d="M9 9h.01"/>
            <path d="m15 9-6 6"/>
            <path d="M15 15h.01"/>
          </svg>
        </span>
        Bono: {bono}
      </p>
      <p class="bono-desc">Se trata de paquetes de sesiones que se van consumiendo en el tiempo. La mejor inversión en salud y una forma eficaz de reducir el coste del tratamiento.</p>
    </div>

    <a class="btn btn-green" href={CALENDLY_URL} target="_blank" rel="noopener">
      Reservar primera sesión →
    </a>
  </div>
 </div>
</section>

<section class="other-services">
  <div class="other-services-inner">
    <h2 class="reveal">Otros servicios</h2>
    <div class="other-grid">
      {otherServices.map((service) => (
        <a class="other-card reveal" href={service.href}>
          <div class="other-card-body">
            <p class="tag">{service.tag}</p>
            <h4>{service.title}</h4>
            <p>{service.desc}</p>
          </div>
          <span class="chev" aria-hidden="true">›</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.therapy-hero {
  background: var(--color-bg-base);
  padding: 40px var(--gutter);
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
}
.therapy-hero-inner {
  width: 100%;
  max-width: 1010px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}
.therapy-hero h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 30px;
