  font-weight: var(--fw-semi);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  margin: 0 0 8px;
}
.modalidad-item p {
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin: 0;
}

.therapy-gallery {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.therapy-gallery-inner {
  width: 100%;
  max-width: 1280px;
  display: flex;
  flex-direction: column;
}
.gallery-photo {
  position: relative;
  background: var(--color-bg-muted);
  height: 420px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 20px 16px;
}
.gallery-track {
  position: absolute;
  inset: 0;
  display: flex;
  height: 100%;
  transition: transform 280ms ease;
  touch-action: pan-y;
}
.gallery-track.dragging { transition: none; }
.gallery-slide {
  flex: 0 0 100%;
  width: 100%;
  height: 100%;
}
.gallery-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}
.gallery-dots {
  position: relative;
  z-index: 1;
  max-width: 100%;
  overflow-x: auto;
  background: rgba(51,51,51,.5);
  backdrop-filter: blur(12px);
  border-radius: 9999px;
  padding: 10px 12px;
  display: flex;
  gap: 6px;
  scrollbar-width: none;
}
.gallery-dots::-webkit-scrollbar { display: none; }
.gallery-dots :global(button) {
  flex: 0 0 auto;
  width: 8px;
  height: 8px;
  padding: 0;
  border: none;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,.4);
  cursor: pointer;
  transition: background-color 200ms ease, transform 200ms ease;
}
.gallery-dots :global(button:hover) { background: rgba(255,255,255,.7); }
.gallery-dots :global(button[aria-current="true"]) {
  background: #fff;
  transform: scale(1.25);
}
.gallery-arrow {
  display: none;
  position: absolute;
  z-index: 1;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: var(--radius-full);
  background: rgba(51,51,51,.8);
  backdrop-filter: blur(12px);
  border: none;
  color: #fff;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: filter var(--transition-fast);
}
.gallery-arrow:hover { filter: brightness(1.15); }
.gallery-arrow.next { right: 16px; }
.gallery-arrow.prev { left: 16px; }

.location-panel {
  background: var(--color-bg-base);
  padding: 24px var(--gutter);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.panel-card {
  background: var(--color-bg-soft);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 16px;
}
.panel-card h3 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 20px;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}

.location-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.location-list li {
  position: relative;
  padding-left: 20px;
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--color-text-secondary);
}
.location-list li::before {
  content: "•";
  position: absolute;
  left: 2px;
  color: var(--color-text-primary);
}
.location-list b {
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
}

.price-label {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body-sm);
  letter-spacing: var(--ls-wide);
