  color: var(--color-text-primary);
  margin: 0;
}

.badge-icon {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: var(--color-clay);
}

.bono-card .bono-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 18px;
  color: var(--color-text-primary);
  margin: 0 0 8px;
}
.bono-card .bono-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 44px;
  padding: 8px 16px;
