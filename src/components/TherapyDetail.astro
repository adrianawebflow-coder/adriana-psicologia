  left: 2px;
  color: var(--color-text-primary);
}
.section-list b {
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
}

.therapy-info {
  background: var(--color-bg-soft);
  padding: 40px var(--gutter) 44px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
}
