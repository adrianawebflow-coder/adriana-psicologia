---
import Layout from '../layouts/Layout.astro';
import CTAFinalSection from '../components/CTAFinalSection.astro';
import { pasos } from '../data/pasos';

const CALENDLY_URL = 'https://calendly.com/adrianapsicologia/15-20min';

const faqs = [
  {
    q: '¿Cuánto dura el proceso?',
    a: 'Depende de cada persona y de lo que la trae a terapia. Algunos procesos duran unos meses y otros, más tiempo. Lo iremos revisando de forma periódica.',
  },
  {
    q: '¿Con qué frecuencia nos vemos?',
    a: 'Normalmente, una sesión semanal o quincenal de 55 minutos. La frecuencia se acuerda en la propuesta de tratamiento y puede ajustarse a medida que avanza el proceso.',
  },
  {
    q: '¿Es confidencial?',
    a: 'Sí. Todo lo que compartas en sesión está protegido por el secreto profesional, salvo en las excepciones que marca la ley, como un riesgo grave para ti o para terceros.',
  },
  {
    q: '¿Qué pasa si quiero dejarlo?',
    a: 'Puedes dejar la terapia cuando lo decidas. Lo ideal es hablarlo en sesión, para cerrar el proceso de forma cuidada y valorar juntos cómo estás.',
  },
  {
    q: '¿Necesito un diagnóstico previo?',
    a: 'No. No necesitas un diagnóstico ni saber exactamente qué te pasa para empezar. En la sesión de evaluación exploraremos juntos qué te trae a consulta.',
  },
];
---

<Layout
  title="Cómo funciona"
  description="Dar el paso de comenzar terapia puede generar muchas dudas. Así es el proceso con Adriana Psicología desde el primer contacto."
>

  <section class="como-hero">
    <div class="container">
      <h1 transition:name="hero-title">¿Cómo es una sesión con Adriana?</h1>
      <p class="lede">Dar el paso de comenzar terapia puede generar muchas dudas. Aquí te explico cómo será el proceso desde el primer contacto.</p>
    </div>
  </section>

  <section class="pasos">
    <div class="container">
      <h2 class="section-title reveal">Pasos</h2>
      <ol class="steps">
        {pasos.map((paso, i) => (
          <li class="step reveal" id={paso.id}>
            <span class="step-num">{i + 1}</span>
            <div class="step-body">
              <h3>{paso.title}</h3>
              <p>{paso.desc}</p>
            </div>
          </li>
        ))}
      </ol>

      <a class="pasos-btn" href={CALENDLY_URL} target="_blank" rel="noopener">
        Reserva tu cita aquí →
      </a>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2 class="section-title reveal">Preguntas frecuentes</h2>
      <p class="faq-lede reveal">Lo desconocido da miedo. Por eso te cuento exactamente qué pasa desde que decides contactar.</p>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item reveal">
            <summary>
              <span>{faq.q}</span>
              <span class="chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTAFinalSection
    heading="La evaluación se realiza sin compromiso"
    text="No necesitas saber exactamente qué te pasa para empezar a hablar de ello."
  />

</Layout>

<style>
.container {
  max-width: 1010px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── Hero ── */
.como-hero {
  background: var(--color-bg-soft);
  padding: 40px 0;
  text-align: left;
}
.como-hero h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 30px;
  line-height: 1.2;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.como-hero .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
  max-width: 46ch;
}

.section-title {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h2);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 24px;
  text-align: center;
}

/* ── Pasos ── */
.pasos {
  background: var(--color-bg-base);
  padding-top: 24px;
  padding-bottom: 60px;
}
.pasos .section-title {
  text-align: left;
}

.steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  max-width: 640px;
  margin: 0 auto;
}

.pasos-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  width: fit-content;
  margin: 32px auto 0;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  background: var(--color-moss);
  border: 1px solid var(--color-text-primary);
  color: #fff;
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body-sm);
  text-decoration: none;
  transition: transform var(--transition-fast), filter var(--transition-fast);
}
.pasos-btn:hover {
  color: #fff;
  transform: translateY(-1px);
  filter: brightness(1.06);
}
.step {
  position: relative;
  display: grid;
  grid-template-columns: 48px 1fr;
  align-items: flex-start;
  column-gap: 20px;
  padding-bottom: 32px;
  list-style: none;
}
.step::marker { content: none; }
.step:last-child { padding-bottom: 0; }

.step-num {
  position: relative;
  z-index: 1;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 50%;
  border: 1.5px solid var(--color-clay-soft);
  background: #fff;
  display: grid;
  place-items: center;
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: 18px;
  color: var(--color-text-primary);
}

.step-body h3 {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  margin: 0 0 8px;
}
.step-body p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

/* ── FAQ ── */
.faq {
  background: var(--color-bg-soft);
  padding: 40px 0 60px;
}
.faq .section-title { text-align: center; }
.faq-lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 auto 24px;
  max-width: 46ch;
  text-align: center;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.faq-item {
  background: #FAF9F5;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 4px 16px;
  width: 100%;
  max-width: 598px;
  margin: 0 auto;
}
.faq-item summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 0;
  cursor: pointer;
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item .chevron {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-moss-soft);
  color: var(--color-moss);
  display: grid;
  place-items: center;
  transition: transform var(--transition-fast);
}
.faq-item[open] .chevron { transform: rotate(180deg); }
.faq-item p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 16px;
}

@media (min-width: 900px) {
  .como-hero { padding: 80px 0; text-align: center; }
  .como-hero h1 { font-size: 40px; }
  .como-hero .lede { font-size: var(--fs-body-lg); max-width: 52ch; margin: 0 auto; }

  .pasos .section-title { text-align: center; }

  .steps { max-width: 720px; }
  .step { width: 440px; }
  .step:nth-child(even) { margin-left: 160px; }
}
</style>
