---
import { CALENDLY_URL } from '../data/site';
import Layout from '../layouts/Layout.astro';
import CTAFinalSection from '../components/CTAFinalSection.astro';
import { pasos } from '../data/pasos';
import { faqs } from '../data/faqs';


---

<Layout
  title="Cómo funciona"
  description="Dar el paso de comenzar terapia puede generar muchas dudas. Así es el proceso con Adriana Psicología desde el primer contacto."
>

  <section class="como-hero">
    <div class="container">
      <h1 transition:name="hero-title">¿Cómo es una sesión con Adriana?</h1>
      <p class="lede">Dar el paso de comenzar terapia puede generar muchas dudas. Aquí te explico cómo será el proceso desde el primer contacto.</p>
    </div>
  </section>

  <section class="pasos">
    <div class="container">
      <h2 class="section-title reveal">Pasos</h2>
      <div class="steps-wrap" id="stepsWrap">
      <svg class="steps-path" aria-hidden="true"><path /></svg>
      <ol class="steps">
        {pasos.map((paso, i) => (
          <li class="step" id={paso.id} style={`--i: ${i}`}>
            <span class="step-num">{i + 1}</span>
            <div class="step-body">
              <h3>{paso.title}</h3>
              <p>{paso.desc}</p>
            </div>
          </li>
        ))}
      </ol>
      </div>

      <a class="pasos-btn" href={CALENDLY_URL} target="_blank" rel="noopener">
        Reserva tu cita aquí →
      </a>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2 class="section-title reveal">Preguntas frecuentes</h2>
      <p class="faq-lede reveal">Lo desconocido da miedo. Por eso te cuento exactamente qué pasa desde que decides contactar.</p>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item reveal">
            <summary>
              <span>{faq.q}</span>
              <span class="chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTAFinalSection
    heading="La evaluación se realiza sin compromiso"
    text="No necesitas saber exactamente qué te pasa para empezar a hablar de ello."
  />

</Layout>

<style>
.container {
  max-width: 1010px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── Hero ── */
.como-hero {
  background: var(--color-bg-soft);
  padding: 40px 0;
  text-align: left;
}
.como-hero h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 30px;
  line-height: 1.2;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.como-hero .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
  max-width: 46ch;
}

.section-title {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h2);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 24px;
  text-align: center;
}

/* ── Pasos ── */
.pasos {
  background: var(--color-bg-base);
  padding-top: 24px;
  padding-bottom: 60px;
}
.pasos .section-title {
  text-align: left;
}

.steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ── Animación de entrada de los pasos ──
   Al entrar en pantalla, una línea se dibuja uniendo los números (la
   calcula el script según el layout) y cada paso aparece a su ritmo: el
   número con un rebote y una onda, y el texto deslizándose. Sin JS o con
   movimiento reducido, todo se ve directamente. */
.steps-wrap {
  position: relative;
  max-width: 640px;
  margin: 0 auto;
}
.steps-path {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
  pointer-events: none;
}
.steps-path path {
  fill: none;
  stroke: var(--color-clay-soft);
  stroke-width: 2;
  stroke-linecap: round;
}

.step-num::after {
  content: '';
  position: absolute;
  inset: -1.5px;
  border-radius: 50%;
  border: 2px solid var(--color-moss);
  opacity: 0;
  pointer-events: none;
}

.js .steps-wrap .step-num {
  opacity: 0;
  transform: scale(0.3);
}
.js .steps-wrap .step-body {
  opacity: 0;
  transform: translateX(-20px);
}
.js .steps-wrap.is-in .step-num {
  opacity: 1;
  transform: none;
  transition:
    opacity 300ms ease calc(var(--i) * 380ms),
    transform 650ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 380ms);
  animation: step-fill 1100ms ease-out calc(var(--i) * 380ms) both;
}
.js .steps-wrap.is-in .step-num::after {
  animation: step-ripple 900ms ease-out calc(var(--i) * 380ms + 200ms) both;
}
.js .steps-wrap.is-in .step-body {
  opacity: 1;
  transform: none;
  transition:
    opacity 500ms ease calc(var(--i) * 380ms + 150ms),
    transform 650ms cubic-bezier(0.22, 1, 0.36, 1) calc(var(--i) * 380ms + 150ms);
}

/* El número se enciende en musgo y vuelve a su estado normal. */
@keyframes step-fill {
  0%, 35% { background: var(--color-moss); color: #fff; border-color: var(--color-moss); }
  100%    { background: #fff; color: var(--color-text-primary); border-color: var(--color-clay-soft); }
}
@keyframes step-ripple {
  0%   { opacity: 0.6; transform: scale(1); }
  100% { opacity: 0;   transform: scale(1.7); }
}

@media (prefers-reduced-motion: reduce) {
  .js .steps-wrap .step-num,
  .js .steps-wrap .step-body {
    opacity: 1;
    transform: none;
    transition: none;
    animation: none;
  }
  .js .steps-wrap .step-num::after { animation: none; }
}

.pasos-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48px;
  width: fit-content;
  margin: 32px auto 0;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  background: var(--color-moss);
  border: 1px solid var(--color-text-primary);
  color: #fff;
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body-sm);
  text-decoration: none;
  transition: transform var(--transition-fast), filter var(--transition-fast);
}
.pasos-btn:hover {
  color: #fff;
  transform: translateY(-1px);
  filter: brightness(1.06);
}
.step {
  position: relative;
  display: grid;
  grid-template-columns: 48px 1fr;
  align-items: flex-start;
  column-gap: 20px;
  padding-bottom: 32px;
  list-style: none;
}
.step::marker { content: none; }
.step:last-child { padding-bottom: 0; }

.step-num {
  position: relative;
  z-index: 1;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 50%;
  border: 1.5px solid var(--color-clay-soft);
  background: #fff;
  display: grid;
  place-items: center;
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: 18px;
  color: var(--color-text-primary);
}

.step-body h3 {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  margin: 0 0 8px;
}
.step-body p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

/* ── FAQ ── */
.faq {
  background: var(--color-bg-soft);
  padding: 40px 0 60px;
}
.faq .section-title { text-align: center; }
.faq-lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 auto 24px;
  max-width: 46ch;
  text-align: center;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.faq-item {
  background: #FAF9F5;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 4px 16px;
  width: 100%;
  max-width: 598px;
  margin: 0 auto;
}
.faq-item summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 0;
  cursor: pointer;
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item .chevron {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-moss-soft);
  color: var(--color-moss);
  display: grid;
  place-items: center;
  transition: transform var(--transition-fast);
}
.faq-item[open] .chevron { transform: rotate(180deg); }
.faq-item p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 16px;
}

@media (min-width: 900px) {
  .como-hero { padding: 80px 0; text-align: center; }
  .como-hero h1 { font-size: 40px; }
  .como-hero .lede { font-size: var(--fs-body-lg); max-width: 52ch; margin: 0 auto; }

  .pasos .section-title { text-align: center; }

  .steps-wrap { max-width: 720px; }
  .step { width: 440px; }
  .step:nth-child(even) { margin-left: 160px; }
}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const wrapEl = document.getElementById('stepsWrap');
    const pathEl = wrapEl?.querySelector<SVGPathElement>('.steps-path path');
    if (!wrapEl || !pathEl) return;
    const wrap = wrapEl;
    const path = pathEl;
    const STAGGER = 380; // ms entre pasos; igual que --i * 380ms en el CSS

    // Trazado que une los números: baja por la columna del número, cruza en
    // horizontal por el hueco entre pasos (sin pisar el texto) y baja hasta
    // el siguiente. En mobile los números están alineados: es una recta.
    function draw() {
      const box = wrap.getBoundingClientRect();
      const steps = Array.from(wrap.querySelectorAll<HTMLElement>('.step'));
      const pts = steps.map((step) => {
        const n = step.querySelector('.step-num')!.getBoundingClientRect();
        const body = step.querySelector('.step-body')!.getBoundingClientRect();
        return {
          x: n.left - box.left + n.width / 2,
          y: n.top - box.top + n.height / 2,
          top: step.getBoundingClientRect().top - box.top,
          bottom: Math.max(n.bottom, body.bottom) - box.top,
        };
      });
      if (pts.length < 2) return;
      const R = 16;
      let d = `M ${pts[0].x} ${pts[0].y}`;
      for (let i = 1; i < pts.length; i++) {
        const a = pts[i - 1];
        const b = pts[i];
        if (Math.abs(a.x - b.x) < 1) { d += ` V ${b.y}`; continue; }
        const midY = (a.bottom + b.top) / 2;
        const dir = Math.sign(b.x - a.x);
        d += ` V ${midY - R} Q ${a.x} ${midY} ${a.x + dir * R} ${midY}`;
        d += ` H ${b.x - dir * R} Q ${b.x} ${midY} ${b.x} ${midY + R} V ${b.y}`;
      }
      path.setAttribute('d', d);
      const len = path.getTotalLength();
      path.style.transition = 'none';
      path.style.strokeDasharray = String(len);
      path.style.strokeDashoffset = wrap.classList.contains('is-in') ? '0' : String(len);
      return pts.length;
    }

    const count = draw() ?? 0;
    new ResizeObserver(() => draw()).observe(wrap);

    function play() {
      wrap.classList.add('is-in');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      void path.getBoundingClientRect();
      path.style.transition = reduced ? 'none' : `stroke-dashoffset ${(count - 1) * STAGGER}ms linear 150ms`;
      path.style.strokeDashoffset = '0';
    }

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      play();
      return;
    }
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        io.disconnect();
        play();
      }
    }, { threshold: 0.25 });
    io.observe(wrap);
  });
</script>
