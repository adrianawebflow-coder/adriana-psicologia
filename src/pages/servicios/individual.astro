---
import Layout from '../../layouts/Layout.astro';

const CALENDLY_URL = 'https://calendly.com/adrianapsicologia/15-20min';
---

<Layout
  title="Terapia individual"
  description="Proceso en el que una persona explora sus emociones, pensamientos y comportamientos para adquirir herramientas de crecimiento personal y bienestar emocional."
>

  <section class="therapy-hero">
    <div class="therapy-hero-inner">
      <div>
        <h1>Terapia individual</h1>
        <p class="lede">Proceso en el que una persona explora sus emociones, pensamientos y comportamientos para adquirir herramientas de crecimiento personal y bienestar emocional.</p>
      </div>
      <div>
        <h2>¿En qué consiste?</h2>
        <p class="desc">La terapia individual tiene como objetivo fortalecer la salud mental, mejorar la calidad de vida y desarrollar habilidades para afrontar cualquier tipo de dificultad.</p>
      </div>
    </div>
  </section>

  <section class="therapy-info">
    <div class="therapy-info-inner">
      <h2>Información de la terapia</h2>
      <div class="info-grid">
        <div class="info-card">
          <h3>Presencial</h3>
          <p>Entorno cómodo y seguro para trabajar cara a cara en el despacho en Madrid.</p>
        </div>
        <div class="info-card">
          <h3>Online</h3>
          <p>Acceso a la terapia desde tu hogar, a través de plataformas de telepsicología.</p>
        </div>
        <div class="info-card">
          <h3>Mixto</h3>
          <p>Combinación de sesiones presenciales y online según la necesidad del paciente.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="therapy-gallery">
    <div class="gallery-photo">
      <div class="gallery-dots" aria-hidden="true">
        <span class="active"></span><span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="location-panel">
      <div class="location-box">
        <div class="details">
          <h3>📍 Despacho en Manoteras, Madrid</h3>
          <p><b>Metro</b>: Línea 4 – Manoteras (5 min) · Línea 1 – Pinar de Chamartín (15 min).</p>
          <p><b>Cercanías</b>: Fuente de la Mora, líneas C1, C2, C7 y C10 (15 min andando).</p>
          <p><b>Bus</b>: 129, 29, 7 · Paradas Alicún y Almanzora.</p>
          <p><b>Parking</b>: Gratuito en calles cercanas, sin parquímetro.</p>
        </div>
      </div>
      <div class="price-block">
        <div class="price-card">
          <p class="price-label">Precio</p>
          <p class="price-value">Desde 60€ / sesión</p>
        </div>
        <a class="btn btn-green" href={CALENDLY_URL} target="_blank" rel="noopener">
          Reservar primera sesión →
        </a>
      </div>
    </div>
  </section>

  <section class="other-services">
    <div class="other-services-inner">
      <h2>Otros servicios</h2>
      <div class="other-grid">
        <a class="other-card" href="/servicios?tipo=parejas">
          <div class="other-card-body">
            <p class="tag">Parejas</p>
            <h4>Mi relación necesita ayuda</h4>
            <p>Tu relación ya no es como antes.</p>
          </div>
          <span class="chev" aria-hidden="true">›</span>
        </a>
        <a class="other-card" href="/servicios?tipo=familias">
          <div class="other-card-body">
            <p class="tag">Familias</p>
            <h4>Es para mi hij@</h4>
            <p>Te cuesta entender lo que le pasa a tu hij@</p>
          </div>
          <span class="chev" aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
.therapy-hero {
  background: var(--color-bg-base);
  padding: 40px var(--gutter);
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
}
.therapy-hero-inner {
  width: 100%;
  max-width: 1010px;
  display: flex;
  flex-direction: column;
  gap: 32px;
}
.therapy-hero h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 30px;
  line-height: 1.1;
  color: var(--color-text-primary);
  margin: 0;
}
.therapy-hero .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin: 8px 0 0;
}
.therapy-hero h2 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 22px;
  line-height: 1.1;
  color: var(--color-text-primary);
  margin: 0;
}
.therapy-hero .desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin: 8px 0 0;
}

.therapy-info {
  background: var(--color-bg-soft);
  padding: 40px var(--gutter) 44px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
}
.therapy-info-inner {
  width: 100%;
  max-width: 1010px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.therapy-info h2 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 24px;
  color: var(--color-text-primary);
  margin: 0;
}
.info-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.info-card {
  background: var(--color-bg-base);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border-bottom: 2px solid var(--color-clay-soft);
  padding: 16px;
}
.info-card h3 {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
  margin: 0 0 8px;
}
.info-card p {
  font-family: var(--font-sans);
  font-size: 15px;
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin: 0;
}

.therapy-gallery {
  display: flex;
  flex-direction: column;
}
.gallery-photo {
  position: relative;
  background: var(--color-bg-muted) url('/images/modalidad.png') center / cover no-repeat;
  height: 280px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 20px 16px;
}
.gallery-dots {
  background: rgba(51,51,51,.5);
  backdrop-filter: blur(12px);
  border-radius: 12px;
  padding: 12px;
  display: flex;
  gap: 8px;
}
.gallery-dots span {
  width: 16px;
  height: 16px;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,.4);
}
.gallery-dots span.active { background: #fff; }

.location-panel {
  background: var(--color-bg-base);
  padding: 24px var(--gutter);
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.location-box .details h3 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 20px;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.location-box .details {
  background: var(--color-bg-soft);
  border-radius: var(--radius-lg);
  padding: 16px;
}
.location-box .details p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.65;
  color: var(--color-text-secondary);
  margin: 0 0 8px;
}
.location-box .details p:last-child { margin-bottom: 0; }
.location-box .details b {
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
}

.price-block {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.price-card {
  background: var(--color-bg-soft);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 16px;
}
.price-label {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body-sm);
  letter-spacing: var(--ls-wide);
  color: var(--color-text-muted);
  text-transform: uppercase;
  margin: 0 0 8px;
}
.price-value {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 22px;
  color: var(--color-text-primary);
  margin: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 44px;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  white-space: nowrap;
  transition: transform var(--transition-fast), filter var(--transition-fast);
  border: none;
  cursor: pointer;
  text-decoration: none;
}
.btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
.btn-green {
  background: var(--color-moss);
  border: 1px solid var(--color-text-primary);
  color: #fff;
  font-weight: var(--fw-medium);
  width: 100%;
}
.btn-green:hover { color: #fff; }

.other-services {
  background: var(--color-bg-soft);
  padding: 40px var(--gutter) 44px;
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: center;
}
.other-services-inner {
  width: 100%;
  max-width: 1010px;
  display: flex;
  flex-direction: column;
  gap: 24px;
}
.other-services h2 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 24px;
  color: var(--color-text-primary);
  margin: 0;
}
.other-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}
.other-card {
  background: var(--color-bg-base);
  border: 1px solid var(--color-moss-soft);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
}
.other-card:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
  border-color: var(--color-moss);
}
.other-card-body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.other-card .tag {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body-sm);
  color: var(--color-clay-hover);
  margin: 0;
}
.other-card h4 {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h4);
  color: var(--color-text-primary);
  margin: 0;
}
.other-card p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  color: var(--color-text-secondary);
  margin: 0;
}
.other-card .chev {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: var(--radius-full);
  background: var(--color-moss-soft);
  color: var(--color-moss);
  display: grid;
  place-items: center;
  font-size: var(--fs-body-sm);
}
.other-card:hover .chev {
  background: var(--color-moss);
  color: #fff;
}

@media (min-width: 1000px) {
  .therapy-hero { padding: 60px 40px; }
  .therapy-hero-inner { flex-direction: row; gap: 64px; }
  .therapy-hero-inner > div { flex: 1 1 0; }
  .therapy-hero h1 { font-size: 34px; }

  .therapy-info { padding: 40px 135px 60px; }
  .info-grid { flex-direction: row; }
  .info-card { flex: 1 1 0; }

  .therapy-gallery { flex-direction: row; align-items: stretch; }
  .gallery-photo { flex: 1 1 0; height: 475px; }
  .location-panel {
    flex: 0 0 570px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 40px 40px;
    justify-content: center;
  }

  .other-services { padding: 60px 135px; }
  .other-grid { flex-direction: row; }
  .other-card { flex: 1 1 0; }
}
</style>
