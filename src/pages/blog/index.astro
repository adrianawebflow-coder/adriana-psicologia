---
import Layout from '../../layouts/Layout.astro';
import CTAFinalSection from '../../components/CTAFinalSection.astro';
import { posts, categories } from '../../data/blogPosts';

const gridPosts = posts;

// Los 3 artículos más leídos según Google Analytics, con sus métricas reales.
const MOST_READ = [
  { slug: 'el-sindrome-de-peter-pan-y-wendy-en-la-dinamica-de-pareja', visits: 37, avgReadSeconds: 65 },
  { slug: 'en-busqueda-del-amor-ideal-el-sindrome-de-madame-bovary', visits: 9, avgReadSeconds: 55 },
  { slug: 'que-son-los-matrimonios-zombies', visits: 8, avgReadSeconds: 77 },
];
const sidebarPosts = MOST_READ.map(({ slug, visits, avgReadSeconds }) => {
  const post = posts.find((p) => p.slug === slug);
  if (!post) throw new Error(`Post más leído no encontrado: ${slug}`);
  return { ...post, visits, avgReadSeconds };
});
---

<Layout
  title="Blog"
  description="Recursos, reflexiones y artículos sobre salud mental, terapia y bienestar emocional para adolescentes, adultos, parejas y familias."
>

  <section class="blog-hero">
    <div class="container">
      <h1 transition:name="hero-title">Artículos y posts donde hablo de psicología</h1>
      <p class="lede">¡Bienvenid@ a mi blog! Aquí encontrarás artículos informativos y reflexiones en profundidad sobre psicología. Además, encontrarás entrevistas y colaboraciones en medios que amplían tu comprensión de la mente y el bienestar.</p>
    </div>
  </section>

  <section class="blog-body">
    <div class="container blog-layout">
      <aside class="blog-sidebar">
        <h2 class="sidebar-title">Artículos más leídos</h2>
        <ul class="sidebar-list">
          {sidebarPosts.map((post) => (
            <li>
              <a class="sidebar-card" href={`/blog/${post.slug}`}>
                <span class="sidebar-thumb">
                  <img src={post.image} alt="" loading="lazy" />
                </span>
                <span class="sidebar-info">
                  <span class="sidebar-post-title">{post.title}</span>
                  <span class="sidebar-stats">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                    {post.avgReadSeconds}s de lectura media
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </aside>

      <div class="blog-main">
        <div class="tabs" role="tablist" aria-label="Categoría" id="blogTabs">
          {categories.map((cat) => (
            <button
              class:list={['tab', { active: cat === 'Todos' }]}
              role="tab"
              aria-selected={cat === 'Todos'}
              data-category={cat}
              type="button"
            >
              {cat}
            </button>
          ))}
        </div>

        <div class="grid">
          {gridPosts.map((post) => (
            <a class="card card-in reveal" href={`/blog/${post.slug}`} data-category={post.category}>
              <img class="card-img" src={post.image} alt="" loading="lazy" />
              <div class="card-body">
                <span class="card-badge">{post.category}</span>
                <h3 class="card-title">{post.title}</h3>
                <p class="card-excerpt">{post.excerpt}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <CTAFinalSection
    heading="No esperes a que todo se derrumbe"
    text="¿List@ para dar el primer paso? Solo es una conversación. Sin compromiso, sin tener que tenerlo todo claro."
  />

</Layout>

<style>
.container {
  max-width: 1180px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── Hero ── */
.blog-hero {
  background: var(--color-bg-soft);
  padding: 40px 0;
}
.blog-hero h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 30px;
  line-height: 1.2;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.blog-hero .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
  max-width: 56ch;
}

/* ── Layout ── */
.blog-body {
  background: var(--color-bg-base);
  padding: 40px 0 60px;
}
.blog-layout {
  display: flex;
  flex-direction: column;
  gap: 40px;
}

/* ── Sidebar ── */
.sidebar-title {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h4);
  color: var(--color-text-primary);
  margin: 0 0 20px;
}
.sidebar-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.sidebar-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 10px;
  border-radius: var(--radius-lg);
  background: #fff;
  box-shadow: var(--shadow-sm);
  text-decoration: none;
  transition: box-shadow var(--transition-fast), transform var(--transition-fast);
}
.sidebar-card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.sidebar-thumb {
  position: relative;
  flex: 0 0 auto;
  width: 64px;
  height: 64px;
  border-radius: var(--radius-md);
  overflow: hidden;
}
.sidebar-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.sidebar-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.sidebar-post-title {
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body-sm);
  line-height: 1.4;
  color: var(--color-text-primary);
  transition: color var(--transition-fast);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.sidebar-card:hover .sidebar-post-title { color: var(--color-moss); }
.sidebar-stats {
  display: flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-sans);
  font-size: var(--fs-meta);
  color: var(--color-text-muted);
}
.sidebar-stats svg { flex: 0 0 auto; color: var(--color-clay); }

/* ── Tabs ── */
.tabs {
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 24px;
  border-bottom: 2px solid var(--color-clay-soft);
  margin-bottom: 24px;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  scroll-snap-type: x proximity;
  scrollbar-width: none;
}
.tabs::-webkit-scrollbar { display: none; }
.tab {
  flex: 0 0 auto;
  padding: 0 0 12px;
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  font-weight: var(--fw-regular);
  color: var(--color-text-muted);
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
  cursor: pointer;
  white-space: nowrap;
  scroll-snap-align: start;
}
.tab.active {
  font-weight: var(--fw-semi);
  color: var(--color-text-secondary);
  border-bottom-color: var(--color-text-secondary);
}

/* ── Grid de artículos ── */
.grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 24px;
}
.card {
  position: relative;
  display: block;
  border-radius: var(--radius-lg);
  overflow: hidden;
  aspect-ratio: 3 / 4;
  text-decoration: none;
  box-shadow: var(--shadow-sm);
  transition: box-shadow var(--transition-fast), transform var(--transition-fast);
}
.card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-2px);
}
.card[hidden] { display: none; }

/* Fade-up al cambiar de tab. No basta con :not([hidden]): una card que ya
   estaba visible bajo "Todos" sigue visible al filtrar por su categoría, así
   que el atributo hidden nunca cambia para ella y la animación no se
   reiniciaría sola. Por eso el JS de más abajo quita y vuelve a añadir esta
   clase (con un reflow forzado) en cada cambio de tab, para todas las cards
   que queden visibles. */
@keyframes cardFadeUp {
  from { opacity: 0; transform: translateY(16px); }
  to   { opacity: 1; transform: translateY(0); }
}
.card.card-in {
  animation: cardFadeUp 420ms cubic-bezier(0.25, 0, 0, 1) both;
}
.card.card-in:nth-child(2) { animation-delay: 40ms; }
.card.card-in:nth-child(3) { animation-delay: 80ms; }
@media (prefers-reduced-motion: reduce) {
  .card.card-in { animation: none; }
}

.card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform var(--transition-slow);
  display: block;
}
.card:hover .card-img { transform: scale(1.04); }

.card::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,.88) 0%, rgba(0,0,0,.55) 42%, rgba(0,0,0,.05) 75%, transparent 100%);
}

.card-body {
  position: absolute;
  z-index: 1;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
  padding: 20px;
}
.card-badge {
  align-self: flex-start;
  padding: 6px 14px;
  border-radius: var(--radius-full);
  background: rgba(255,255,255,.92);
  color: var(--color-text-primary);
  font-family: var(--font-sans);
  font-size: var(--fs-meta);
  font-weight: var(--fw-medium);
}
.card-title {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h4);
  line-height: 1.3;
  color: #fff;
  margin: 0;
  text-shadow: 0 1px 12px rgba(0,0,0,.35);
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.card-excerpt {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  line-height: 1.6;
  color: rgba(255,255,255,.88);
  margin: 0;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (min-width: 640px) {
  .grid { grid-template-columns: repeat(2, 1fr); }
}

@media (min-width: 1000px) {
  .blog-layout {
    flex-direction: row;
    align-items: flex-start;
    gap: 60px;
  }
  .blog-sidebar { order: 2; flex: 0 0 280px; }
  .blog-main { order: 1; flex: 1 1 0; min-width: 0; }
  .grid { grid-template-columns: repeat(3, 1fr); }

  .tabs {
    flex-wrap: wrap;
    overflow-x: visible;
  }
}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabsWrap = document.getElementById('blogTabs');
    if (!tabsWrap) return;

    const tabButtons = Array.from(tabsWrap.querySelectorAll<HTMLButtonElement>('.tab'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.grid .card'));

    function select(category: string) {
      tabButtons.forEach((btn) => {
        const active = btn.dataset.category === category;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-selected', String(active));
      });

      const visible: HTMLElement[] = [];
      cards.forEach((card) => {
        const show = category === 'Todos' || card.dataset.category === category;
        card.hidden = !show;
        if (show) visible.push(card);
      });

      // Reinicia el fade-up en todas las cards visibles, aunque ya lo
      // estuvieran antes del cambio de tab (quitar y reponer la clase con
      // un reflow forzado en medio obliga al navegador a relanzar la
      // animación desde cero).
      visible.forEach((card) => card.classList.remove('card-in'));
      void tabsWrap!.offsetWidth;
      visible.forEach((card) => card.classList.add('card-in'));
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.category) select(btn.dataset.category);
      });
    });
  });
</script>
