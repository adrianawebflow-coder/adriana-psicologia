---
import Layout from '../../layouts/Layout.astro';
import CTAFinalSection from '../../components/CTAFinalSection.astro';
import { posts, readMinutes, type BlogPostBlock } from '../../data/blogPosts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

// ── Estructura semántica (WCAG 1.3.1, 2.4.6, 2.4.10) ──
// El cuerpo se guarda como una lista plana de bloques {type, text}.
// La agrupamos en secciones (una por h2) y, dentro de cada una,
// detectamos párrafos consecutivos que en realidad son listas
// ("• algo" o "1. algo") para marcarlos como <ul>/<ol> reales.
type ListItem = { kind: 'list'; ordered: boolean; items: string[] };
type ParaItem = { kind: 'p'; text: string };
type Section = { heading: string | null; items: (ParaItem | ListItem)[] };

function groupBody(blocks: BlogPostBlock[]): Section[] {
  const sections: Section[] = [];
  let current: Section = { heading: null, items: [] };
  let pendingList: string[] | null = null;
  let pendingOrdered = false;

  const flushList = () => {
    if (pendingList && pendingList.length) {
      current.items.push({ kind: 'list', ordered: pendingOrdered, items: pendingList });
    }
    pendingList = null;
  };

  for (const block of blocks) {
    if (block.type === 'h2') {
      flushList();
      if (current.heading !== null || current.items.length) sections.push(current);
      current = { heading: block.text, items: [] };
      continue;
    }

    const bulletMatch = block.text.match(/^•\s*(.+)/);
    const orderedMatch = block.text.match(/^\d+\.\s+(.+)/);

    if (bulletMatch) {
      if (pendingList && pendingOrdered) flushList();
      pendingOrdered = false;
      (pendingList ??= []).push(bulletMatch[1]);
    } else if (orderedMatch) {
      if (pendingList && !pendingOrdered) flushList();
      pendingOrdered = true;
      (pendingList ??= []).push(orderedMatch[1]);
    } else {
      flushList();
      current.items.push({ kind: 'p', text: block.text });
    }
  }
  flushList();
  if (current.heading !== null || current.items.length) sections.push(current);
  return sections;
}

const sections = groupBody(post.body);

// ── Siglas: se desarrollan la primera vez que aparecen (WCAG 3.1.4) ──
const ACRONYMS: Record<string, string> = {
  'TCA': 'Trastorno de la Conducta Alimentaria',
  'DSM-V': 'Manual Diagnóstico y Estadístico de los Trastornos Mentales, 5ª edición',
  'OMS': 'Organización Mundial de la Salud',
  'INE': 'Instituto Nacional de Estadística',
  'UCM': 'Universidad Complutense de Madrid',
  'TIC': 'Tecnologías de la Información y la Comunicación',
  'PNL': 'Programación Neurolingüística',
};
const expandedAcronyms = new Set<string>();

function escapeHtml(text: string): string {
  return text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;');
}

function renderText(text: string): string {
  let html = escapeHtml(text);
  for (const [acronym, expansion] of Object.entries(ACRONYMS)) {
    if (expandedAcronyms.has(acronym)) continue;
    const re = new RegExp(`\\b${acronym.replace('-', '\\-')}\\b`);
    if (re.test(html)) {
      html = html.replace(re, `<abbr title="${escapeHtml(expansion)}">${acronym}</abbr>`);
      expandedAcronyms.add(acronym);
    }
  }
  return html;
}
---

<Layout
  title={post.title}
  description={post.excerpt}
>

  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar" id="readingProgressBar"></div>
  </div>

  <section class="post-hero">
    <div class="container post-hero-grid">
      <div class="post-hero-text">
        <h1 id="post-title">{post.title}</h1>
        <p class="lede">{post.excerpt}</p>
        <div class="author">
          <img class="author-avatar" src="/images/adriana.png" alt={post.author.name} />
          <div class="author-meta">
            <p class="author-name">{post.author.name}</p>
            <p class="author-role">{post.author.role} · {readMinutes(post)} min lectura</p>
          </div>
        </div>
      </div>
      <figure class="post-hero-image">
        <img src={post.image} alt="" fetchpriority="high" />
        <figcaption class="sr-only">Fotografía ilustrativa del artículo «{post.title}»</figcaption>
      </figure>
    </div>
  </section>

  <section class="post-body">
    <div class="container">
      <article aria-labelledby="post-title">
        {sections.map((section) => (
          <section>
            {section.heading && <h2>{section.heading}</h2>}
            {section.items.map((item) =>
              item.kind === 'list' ? (
                item.ordered ? (
                  <ol>
                    {item.items.map((text) => <li set:html={renderText(text)} />)}
                  </ol>
                ) : (
                  <ul>
                    {item.items.map((text) => <li set:html={renderText(text)} />)}
                  </ul>
                )
              ) : (
                <p set:html={renderText(item.text)} />
              )
            )}
          </section>
        ))}
      </article>
    </div>
  </section>

  <CTAFinalSection
    heading="No esperes a que todo se derrumbe"
    text="¿List@ para dar el primer paso? Solo es una conversación. Sin compromiso, sin tener que tenerlo todo claro."
  />

</Layout>

<style>
.container {
  max-width: 1010px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── Progreso de lectura ── */
.reading-progress {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 4px;
  z-index: 40;
  background: transparent;
}
.reading-progress-bar {
  height: 100%;
  width: 0%;
  background: var(--color-success);
  transition: width 100ms linear;
}
@media (prefers-reduced-motion: reduce) {
  .reading-progress-bar { transition: none; }
}

/* ── Hero ── */
.post-hero {
  background: var(--color-bg-soft);
  padding: 40px 0;
}
.post-hero-grid {
  display: flex;
  flex-direction: column-reverse;
  gap: 24px;
}
.post-hero-text h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 28px;
  line-height: 1.25;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.post-hero-text .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 24px;
}
.author {
  display: flex;
  align-items: center;
  gap: 12px;
}
.author-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}
.author-name {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body-sm);
  color: var(--color-text-primary);
  margin: 0;
}
.author-role {
  font-family: var(--font-sans);
  font-size: var(--fs-meta);
  color: var(--color-text-muted);
  margin: 0;
}

.post-hero-image {
  margin: 0;
}
.post-hero-image img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: var(--radius-lg);
  display: block;
}

/* ── Body ── */
.post-body {
  background: var(--color-bg-base);
  padding: 40px 0 60px;
}
.post-body h2 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h3);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 40px 0 16px;
}
.post-body section:first-child h2 { margin-top: 0; }
.post-body p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.75;
  color: var(--color-text-secondary);
  margin: 0 0 20px;
}
.post-body ul,
.post-body ol {
  margin: 0 0 20px;
  padding-left: 22px;
  color: var(--color-text-secondary);
}
.post-body li {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.75;
  margin-bottom: 8px;
}
.post-body abbr {
  text-decoration-style: dotted;
  cursor: help;
}

@media (min-width: 900px) {
  .post-hero-grid {
    flex-direction: row;
    align-items: center;
    gap: 60px;
  }
  .post-hero-text { flex: 1 1 0; }
  .post-hero-image { flex: 1 1 0; }
  .post-hero-text h1 { font-size: 36px; }

  .post-body .container {
    max-width: 598px;
  }
}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const bar = document.getElementById('readingProgressBar');
    if (!bar) return;

    function update() {
      const scrollable = document.documentElement.scrollHeight - window.innerHeight;
      const pct = scrollable > 0 ? (window.scrollY / scrollable) * 100 : 0;
      bar!.style.width = Math.min(100, Math.max(0, pct)) + '%';
    }

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        update();
        ticking = false;
      });
    }, { passive: true });

    update();
  });
</script>
