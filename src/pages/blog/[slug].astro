---
import Layout from '../../layouts/Layout.astro';
import CTAFinalSection from '../../components/CTAFinalSection.astro';
import { posts, readMinutes } from '../../data/blogPosts';

export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<Layout
  title={post.title}
  description={post.excerpt}
>

  <section class="post-hero">
    <div class="container post-hero-grid">
      <div class="post-hero-text">
        <h1>{post.title}</h1>
        <p class="lede">{post.excerpt}</p>
        <div class="author">
          <img class="author-avatar" src="/images/adriana.png" alt={post.author.name} />
          <div class="author-meta">
            <p class="author-name">{post.author.name}</p>
            <p class="author-role">{post.author.role} · {readMinutes(post)} min lectura</p>
          </div>
        </div>
      </div>
      <div class="post-hero-image">
        <img src={post.image} alt={post.title} fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="post-body">
    <div class="container">
      {post.body.map((block) =>
        block.type === 'h2' ? <h2>{block.text}</h2> : <p>{block.text}</p>
      )}
    </div>
  </section>

  <CTAFinalSection
    heading="No esperes a que todo se derrumbe"
    text="¿List@ para dar el primer paso? Solo es una conversación. Sin compromiso, sin tener que tenerlo todo claro."
  />

</Layout>

<style>
.container {
  max-width: 1010px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── Hero ── */
.post-hero {
  background: var(--color-bg-soft);
  padding: 40px 0;
}
.post-hero-grid {
  display: flex;
  flex-direction: column-reverse;
  gap: 24px;
}
.post-hero-text h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 28px;
  line-height: 1.25;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.post-hero-text .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 24px;
}
.author {
  display: flex;
  align-items: center;
  gap: 12px;
}
.author-avatar {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  object-fit: cover;
}
.author-name {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body-sm);
  color: var(--color-text-primary);
  margin: 0;
}
.author-role {
  font-family: var(--font-sans);
  font-size: var(--fs-meta);
  color: var(--color-text-muted);
  margin: 0;
}

.post-hero-image img {
  width: 100%;
  aspect-ratio: 4 / 3;
  object-fit: cover;
  border-radius: var(--radius-lg);
  display: block;
}

/* ── Body ── */
.post-body {
  background: var(--color-bg-base);
  padding: 40px 0 60px;
}
.post-body h2 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h3);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 40px 0 16px;
}
.post-body h2:first-child { margin-top: 0; }
.post-body p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.75;
  color: var(--color-text-secondary);
  margin: 0 0 20px;
}

@media (min-width: 900px) {
  .post-hero-grid {
    flex-direction: row;
    align-items: center;
    gap: 60px;
  }
  .post-hero-text { flex: 1 1 0; }
  .post-hero-image { flex: 1 1 0; }
  .post-hero-text h1 { font-size: 36px; }

  .post-body .container {
    max-width: 598px;
  }
}
</style>
