---
import { CALENDLY_URL } from '../data/site';
import Layout from '../layouts/Layout.astro';
import CTAFinalSection from '../components/CTAFinalSection.astro';
import { faqs } from '../data/faqs';
import '../styles/steps-animation.css';

// Pasos para reservar la cita de evaluación en Calendly.
const reserva = [
  { text: 'Accede al calendario virtual.' },
  { text: 'Escoge el día y la hora según tu disponibilidad.' },
  { text: 'Introduce tus datos de contacto.' },
  { text: 'Realiza el pago de la cita.', note: 'El importe será descontado en caso de iniciar el tratamiento.' },
  { text: 'Recibirás una confirmación por correo electrónico con los datos de la reserva.' },
];


---

<Layout
  title="Contacto"
  description="Reserva tu cita directamente. Sin formularios largos, sin esperas. Eliges día y hora tú."
>

  <link rel="stylesheet" href="https://assets.calendly.com/assets/external/widget.css" />

  <section class="contacto-hero">
    <div class="container">
      <h1 transition:name="hero-title">Da el primer paso</h1>
      <p class="lede">Reserva tu cita directamente. Sin formularios largos, sin esperas. Eliges día y hora tú.</p>
    </div>
  </section>

  <section class="booking">
    <div class="container booking-grid">
      <div class="booking-steps">
        <h2 class="booking-title reveal">¿Cómo puedo reservar la cita de evaluación?</h2>
        <div class="steps-anim">
        <svg class="steps-path" aria-hidden="true"><path /></svg>
        <ol class="steps">
          {reserva.map((paso, i) => (
            <li class="step" style={`--i: ${i}`}>
              <span class="step-num" aria-hidden="true">{i + 1}</span>
              <div class="step-body">
                <p class="step-text">{paso.text}</p>
                {paso.note && <p class="step-note">{paso.note}</p>}
              </div>
            </li>
          ))}
        </ol>
        </div>
      </div>

      <div class="booking-card reveal">
        <div class="calendly-inline-widget" data-url={CALENDLY_URL}></div>
        <noscript>
          <p class="booking-noscript">
            <a href={CALENDLY_URL}>Abre la agenda de Calendly para reservar tu cita</a>
          </p>
        </noscript>
        <!-- Alternativa si el calendario no carga o no se puede usar -->
        <p class="booking-fallback">
          ¿No ves el calendario o te cuesta usarlo?
          <a href={CALENDLY_URL} target="_blank" rel="noopener">Abre la agenda en Calendly<span class="sr-only"> (se abre en una pestaña nueva)</span></a>.
        </p>
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <h2 class="section-title reveal">Preguntas frecuentes</h2>
      <p class="faq-lede reveal">Lo desconocido da miedo. Por eso te cuento exactamente qué pasa desde que decides contactar.</p>
      <div class="faq-list">
        {faqs.map((faq) => (
          <details class="faq-item reveal">
            <summary>
              <span>{faq.q}</span>
              <span class="chevron" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m6 9 6 6 6-6"/>
                </svg>
              </span>
            </summary>
            <p>{faq.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CTAFinalSection
    heading="Cuidar tu salud mental es también cuidar de la vida que construyes alrededor de ella"
    text=""
  />

</Layout>

<style>
.container {
  max-width: 1010px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ── Hero ── */
.contacto-hero {
  background: var(--color-bg-soft);
  padding: 40px 0;
  text-align: left;
}
.contacto-hero h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 30px;
  line-height: 1.2;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.contacto-hero .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
  max-width: 46ch;
}

.section-title {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h2);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 24px;
}

/* ── Booking (pasos + widget) ── */
.booking {
  background: var(--color-bg-base);
  padding: 40px 0 60px;
}
.booking-grid {
  display: flex;
  flex-direction: column;
  gap: 40px;
}
.booking-title {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h3);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 60px;
}

.steps {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
}
.step {
  position: relative;
  display: grid;
  grid-template-columns: 48px 1fr;
  align-items: flex-start;
  column-gap: 20px;
  padding-bottom: 24px;
  list-style: none;
}
.step::marker { content: none; }
.step:last-child { padding-bottom: 0; }

.step-num {
  position: relative;
  z-index: 1;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border-radius: 50%;
  border: 1.5px solid var(--color-clay-soft);
  background: #fff;
  display: grid;
  place-items: center;
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: 18px;
  color: var(--color-text-primary);
}

.step-body {
  /* Centra la primera línea con el círculo de 48px. */
  padding-top: 11px;
}
.step-body .step-text {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-primary);
  margin: 0;
}
.step-body .step-note {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--color-text-secondary);
  margin: 4px 0 0;
}

.booking-card {
  background: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.booking-card .calendly-inline-widget { flex: 1 1 auto; }
.booking-fallback,
.booking-noscript {
  flex: none;
  margin: 0;
  padding: 14px 20px;
  border-top: 1px solid var(--color-bg-border);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  line-height: 1.5;
  color: var(--color-text-secondary);
}
.booking-fallback a,
.booking-noscript a {
  color: var(--color-moss);
  text-decoration: underline;
  text-underline-offset: 3px;
  overflow-wrap: anywhere;
}
.calendly-inline-widget {
  min-width: 280px;
  height: 620px;
}

/* ── FAQ ── */
.faq {
  background: var(--color-bg-soft);
  padding: 40px 0 60px;
}
.faq .section-title { text-align: center; }
.faq-lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 auto 24px;
  max-width: 46ch;
  text-align: center;
}

.faq-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.faq-item {
  background: #FAF9F5;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 4px 16px;
  width: 100%;
  max-width: 598px;
  margin: 0 auto;
}
.faq-item summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 16px 0;
  cursor: pointer;
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item .chevron {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-moss-soft);
  color: var(--color-moss);
  display: grid;
  place-items: center;
  transition: transform var(--transition-fast);
}
.faq-item[open] .chevron { transform: rotate(180deg); }
.faq-item p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 16px;
}

@media (min-width: 900px) {
  .contacto-hero { padding: 80px 0; text-align: center; }
  .contacto-hero h1 { font-size: 40px; }
  .contacto-hero .lede { font-size: var(--fs-body-lg); max-width: 52ch; margin: 0 auto; }

  .booking-grid {
    flex-direction: row;
    align-items: stretch;
    gap: 60px;
  }
  .booking-steps { flex: 1 1 0; }
  .booking-card { flex: 1 1 0; }
  .calendly-inline-widget { height: 100%; min-height: 680px; }
}
</style>

<script>
  import { initStepsAnimation } from '../scripts/steps-animation';
  document.addEventListener('astro:page-load', initStepsAnimation);
</script>

<script>
  function initCalendly() {
    const el = document.querySelector<HTMLElement>('.calendly-inline-widget');
    if (!el || el.querySelector('iframe')) return;
    const w = (window as any).Calendly;
    if (w) {
      w.initInlineWidget({ url: el.dataset.url, parentElement: el });
    }
  }

  // widget.js pesa bastante y no debe competir con la carga inicial: se pide
  // cuando el bloque entra en pantalla o cuando el navegador queda libre tras
  // cargar la página, lo que ocurra antes (en mobile el bloque queda justo
  // bajo el pliegue, así que está listo cuando el usuario baja).
  // Calendly (su propio widget.js o initInlineWidget) crea el iframe con un
  // título en inglés: se sustituye por uno en español en cuanto aparece o
  // cambia (WCAG 3.1.2 / 4.1.2).
  const IFRAME_TITLE = 'Calendario para reservar tu cita';
  function watchCalendlyTitle(el: Element) {
    const fix = () => {
      const f = el.querySelector('iframe');
      if (f && f.getAttribute('title') !== IFRAME_TITLE) f.setAttribute('title', IFRAME_TITLE);
    };
    fix();
    new MutationObserver(fix).observe(el, { childList: true, subtree: true, attributes: true, attributeFilter: ['title'] });
  }

  document.addEventListener('astro:page-load', () => {
    const el = document.querySelector('.calendly-inline-widget');
    if (!el) return;
    watchCalendlyTitle(el);
    let done = false;
    const start = () => {
      if (done) return;
      done = true;
      io.disconnect();
      loadCalendly();
    };
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) start();
    });
    io.observe(el);
    const whenIdle = () => {
      if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 3000 });
      else setTimeout(start, 2000);
    };
    if (document.readyState === 'complete') whenIdle();
    else window.addEventListener('load', whenIdle, { once: true });
  });

  function loadCalendly() {
    if ((window as any).Calendly) {
      initCalendly();
      return;
    }

    if (!document.getElementById('calendly-widget-script')) {
      const script = document.createElement('script');
      script.id = 'calendly-widget-script';
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      script.onload = initCalendly;
      document.body.appendChild(script);
    } else {
      // El script ya se está cargando desde una navegación anterior;
      // reintenta hasta que Calendly quede disponible en window.
      const retry = setInterval(() => {
        if ((window as any).Calendly) {
          clearInterval(retry);
          initCalendly();
        }
      }, 100);
    }
  }
</script>
