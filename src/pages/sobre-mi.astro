          g2.style.transform = '';
          return;
        }
        const y = lerp(-12, -4, progress);
        const scale = lerp(0.96, 0.985, progress);
        g2.style.transform = `translateY(${y}px) scale(${scale})`;
      }

      card.addEventListener('touchstart', (e) => {
        const t = e.touches[0];
        startX = t.clientX;
        startY = t.clientY;
        dx = 0;
        dragging = true;
        axisLocked = null;
      }, { passive: true });

      card.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const t = e.touches[0];
        dx = t.clientX - startX;
        const dy = t.clientY - startY;
        if (!axisLocked) {
          axisLocked = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
          if (axisLocked === 'x') {
            card.classList.add('dragging');
            pauseColabPeekLoop();
          }
        }
        if (axisLocked !== 'x') return;
        if (dx < 0) {
          setCardX(dx);
          setNextPeek(Math.min(1, Math.abs(dx) / PEEK_DISTANCE));
        } else {
          setCardX(0);
          setNextPeek(0);
