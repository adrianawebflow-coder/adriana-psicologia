              <div class="person-id">
                <h3 class="person-name">Belén Silveira</h3>
                <p class="person-role">Endocrinóloga</p>
              </div>
              <div class="person-socials">
                <a href="https://www.instagram.com/drasilveiranutricion/" target="_blank" rel="noopener" aria-label="Instagram de Belén Silveira">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.3" cy="6.7" r="1" fill="currentColor" stroke="none"/>
                  </svg>
                </a>
                <a href="mailto:drasilveiranutricion@gmail.com" aria-label="Email de Belén Silveira">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="4" width="20" height="16" rx="2"/><path d="M2 6l10 7 10-7"/>
                  </svg>
                </a>
              </div>
            </div>

            <div class="person-slide">
              <div class="person-avatar" role="img" aria-label="Foto de Laura Carreño" style="background-image:url('/images/colab-2.png')"></div>
              <div class="person-id">
                <h3 class="person-name">Laura Carreño</h3>
