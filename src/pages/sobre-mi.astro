<script>
  // Carrusel genérico de dots + flecha, reutilizado por "Mi historia" y "Colaboraciones".
  // sobre-mi.astro no usa transition:persist, así que tras una navegación SPA
  // del ClientRouter este <script> se inserta de nuevo pero el navegador no
  // lo ejecuta salvo que reaccionemos al evento astro:page-load (se dispara
  // tanto en la carga inicial como en cada navegación posterior).
  document.addEventListener('astro:page-load', () => {
    function initCarousel(slideSelector: string, dotsId: string, nextId: string, label: string, onChange?: (slide: Element) => void) {
      const slides = Array.from(document.querySelectorAll(slideSelector));
      const dotsWrap = document.getElementById(dotsId);
      if (!slides.length || !dotsWrap) return;

      dotsWrap.innerHTML = '';
      let idx = 0;

      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `${label} ${i + 1}`);
        dot.addEventListener('click', () => go(i));
        dotsWrap.appendChild(dot);
      });
      const dots = Array.from(dotsWrap.children);

      function go(n: number) {
        idx = (n + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('active', i === idx));
        dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === idx)));
        onChange?.(slides[idx]);
      }

      document.getElementById(nextId)?.addEventListener('click', () => go(idx + 1));
      go(0);
    }

    // Carrusel del hero: los fragmentos viven uno junto a otro en .hero-track;
    // arrastrar (o pulsar la flecha) desplaza el track para que el siguiente/
    // anterior entre visiblemente por el borde, en vez de solo hacer fade.
    function initHeroCarousel() {
      const viewport = document.querySelector<HTMLElement>('.hero-body');
      const track = document.getElementById('heroTrack');
      const dotsWrap = document.getElementById('heroDots');
      const heroTitle = document.getElementById('heroTitle');
      if (!viewport || !track || !dotsWrap) return;

      const slides = Array.from(track.children) as HTMLElement[];
      if (!slides.length) return;

      dotsWrap.innerHTML = '';
      let idx = 0;
      let dx = 0;

      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Fragmento ${i + 1}`);
        dot.addEventListener('click', () => go(i));
        dotsWrap.appendChild(dot);
      });
      const dots = Array.from(dotsWrap.children);

      function place(offset: number) {
        track.style.transform = `translateX(calc(${-idx * 100}% + ${offset}px))`;
      }

      function go(n: number) {
        idx = (n + slides.length) % slides.length;
        dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === idx)));
        if (heroTitle) heroTitle.textContent = slides[idx].dataset.title ?? '';
        place(0);
      }

      document.getElementById('heroNext')?.addEventListener('click', () => go(idx + 1));

      const DRAG_THRESHOLD = 60;
      let startX = 0;
      let startY = 0;
      let dragging = false;
      let axisLocked: 'x' | 'y' | null = null;

      viewport.addEventListener('touchstart', (e) => {
        const t = e.touches[0];
        startX = t.clientX;
        startY = t.clientY;
        dx = 0;
        dragging = true;
        axisLocked = null;
        track.classList.add('dragging');
      }, { passive: true });

      viewport.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const t = e.touches[0];
        dx = t.clientX - startX;
        const dy = t.clientY - startY;
        if (!axisLocked) axisLocked = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        if (axisLocked === 'x') place(dx);
      }, { passive: true });

      function release() {
        if (!dragging) return;
        dragging = false;
        track.classList.remove('dragging');
        if (axisLocked === 'x' && Math.abs(dx) >= DRAG_THRESHOLD) {
          go(dx < 0 ? idx + 1 : idx - 1);
        } else {
          place(0);
        }
      }
      viewport.addEventListener('touchend', release);
      viewport.addEventListener('touchcancel', release);

      window.addEventListener('resize', () => place(0));

      go(0);
    }

    initHeroCarousel();
    initCarousel('.person-card .person-slide', 'colabDots', 'colabNext', 'Colaborador');
  });
</script>
