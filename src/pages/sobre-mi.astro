          function finish() {
            if (settled) return;
            settled = true;
            card.removeEventListener('transitionend', finish);
            nextBtn.click();
            card.classList.add('dragging');
            setCardX(0);
            void card.offsetWidth;
            card.classList.remove('dragging');
            setNextPeek(0);
            resumeColabPeekLoop();
          }
          card.addEventListener('transitionend', finish, { once: true });
          setTimeout(finish, 320);
        } else {
          setCardX(0);
          setNextPeek(0);
          resumeColabPeekLoop();
        }
      }
      card.addEventListener('touchend', release);
      card.addEventListener('touchcancel', release);
    }

    initHeroCarousel();
    initCarousel('.person-card .person-slide', 'colabDots', 'colabNext', 'Colaborador', updateGhosts);
    initColabPeek();
    initColabPeekLoop();
    initColabNav();
    initColabDrag();
  });
</script>
