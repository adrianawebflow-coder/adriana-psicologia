<style>
/* ══ Interacción 1 — Fade-in escalonado al cargar ═════════════
   La foto entra primero; la tarjeta llega 200ms después.
   Usamos clases únicas (sm-hero-*) para no interferir con el
   transition:name="hero-title" del h1 (View Transitions API).
══════════════════════════════════════════════════════════════ */
@keyframes sm-fadein {
  from { opacity: 0; transform: translateY(14px); }
  to   { opacity: 1; transform: translateY(0); }
}

.sm-hero-photo {
  animation: sm-fadein 600ms cubic-bezier(0.25, 0, 0, 1) both;
}

.sm-hero-card {
  animation: sm-fadein 600ms 200ms cubic-bezier(0.25, 0, 0, 1) both;
}

@media (prefers-reduced-motion: reduce) {
  .sm-hero-photo,
  .sm-hero-card {
    animation: none;
    opacity: 1;
    transform: none;
  }
}

/* ── Shared ── */
.container {
  max-width: 1160px;
  margin: 0 auto;
  padding: 0 var(--gutter);
}

.section-title {
  font-family: var(--font-serif);
  font-size: 22px;
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 16px;
  line-height: 1.2;
}
@media (min-width: 960px) {
  .section-title { font-size: 24px; }
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  padding: 0 22px;
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  font-weight: var(--fw-semi);
  text-decoration: none;
  transition: transform 120ms ease, filter 120ms ease;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); filter: brightness(1.05); }
.btn-primary { background: var(--color-moss); color: #fff; }

/* ── Hero ── */
.hero {
  background: var(--color-bg-base);
  padding: 0 0 40px;
}

.hero-stage {
  position: relative;
  max-width: 980px;
  margin: 0 auto;
}

.hero-photo {
  display: block;
  width: 100%;
  height: 270px;
  background: var(--color-bg-muted);
  object-fit: cover;
  object-position: center 20%;
}

.hero-card {
  background: var(--color-text-secondary);
  color: #fff;
  border-radius: 12px;
  padding: 20px;
  margin: -68px 16px 0;
  position: relative;
  z-index: 2;
  min-height: 291px;
  box-shadow: 0 18px 44px rgba(26,33,24,.20);
  display: flex;
  flex-direction: column;
  gap: 20px;
  touch-action: pan-y;
}

.hero-body {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
}

.hero-card h1 {
  font-family: var(--font-serif);
  font-size: 24px;
  font-weight: var(--fw-semi);
  line-height: 1.1;
  letter-spacing: var(--ls-tight);
  color: #fff;
  margin: 0 0 12px;
}

/* Los fragmentos se colocan uno junto a otro; arrastrar/cambiar de slide
   desplaza .hero-track horizontalmente, dejando ver el siguiente/anterior
   entrando por el borde. */
.hero-track {
  display: flex;
  flex-wrap: nowrap;
  flex: 1 1 auto;
  transition: transform 280ms ease;
}
.hero-track.dragging {
  transition: none;
}

.hero-slide {
  flex: 0 0 100%;
  width: 100%;
  box-sizing: border-box;
}

.hero-slide p {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 30px;
  color: #fff;
  margin: 0;
}

.hero-nav {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 32px;
}

.hero-dots {
  display: flex;
  gap: 8px;
  align-items: center;
  justify-content: center;
  flex: 1 1 auto;
}

.hero-dots :global(button) {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  padding: 0;
  border: none;
  background: var(--color-moss-soft);
  opacity: .5;
  cursor: pointer;
  transition: background-color 200ms ease, opacity 200ms ease, transform 200ms ease;
}
.hero-dots :global(button):hover { opacity: .85; transform: scale(1.15); }
.hero-dots :global(button[aria-current="true"]) { background: #fff; opacity: 1; }

.hero-arrow {
  flex: 0 0 32px;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  background: var(--color-moss-soft);
  color: var(--color-moss);
  border: none;
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: transform 150ms ease, filter 150ms ease;
}
.hero-arrow:hover { transform: translateX(2px); filter: brightness(1.06); }

@media (max-width: 879px) {
  .hero-arrow { display: none; }
}

@media (min-width: 880px) {
  .hero {
    padding: 40px 0 80px;
  }
  .hero-stage {
    width: min(100%, 760px);
    aspect-ratio: 1520 / 812;
  }
  .hero-photo {
    position: absolute;
    left: 0;
    top: 0;
    width: 61.8%;
    height: 73.2%;
    border-radius: 12px;
    box-shadow: 0 4px 4px rgba(0,0,0,.25);
  }
  .hero-card {
    position: absolute;
    left: 44.4%;
    top: 37.8%;
    width: 55.6%;
    margin: 0;
    min-height: 245px;
  }
}

/* ── Mi enfoque + Mi experiencia ── */
.twocol {
  background: var(--color-bg-soft);
  padding: 40px 0;
}

.twocol-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 40px;
}

.twocol-intro {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 26px;
  color: var(--color-text-secondary);
  margin: 0 0 32px;
  max-width: 44ch;
}

/* Enfoque */
.enfoque-list {
  display: flex;
  flex-direction: column;
  gap: 24px;
  align-items: flex-start;
}

.enfoque-card {
  width: 100%;
  max-width: 440px;
  background: #FAF9F5;
  border: 1px solid var(--color-moss-soft);
  border-left: 6px solid var(--color-moss-soft);
  border-radius: 8px;
  box-shadow: 0 2px 8px rgba(26,33,24,0.06);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.enfoque-card:nth-child(2) { margin-left: 60px; }
.enfoque-card:nth-child(3) { margin-left: 120px; }
@media (max-width: 620px) {
  .enfoque-card:nth-child(2),
  .enfoque-card:nth-child(3) { margin-left: 0; }
}

.enfoque-card h3 {
  font-family: var(--font-sans);
  font-size: 16px;
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  margin: 0;
  line-height: 1.1;
}

.enfoque-card p {
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 26px;
  color: #333;
  margin: 0;
}

/* Experiencia timeline */
.exp-timeline {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0 8px;
  align-items: stretch;
}

.rail {
  position: relative;
  width: 28px;
}
.rail i {
  position: absolute;
  left: 5px;
  top: 8px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  background: var(--color-moss);
}
.rail b {
  position: absolute;
  left: 11px;
  top: 25px;
  bottom: 0;
  width: 6px;
  background: linear-gradient(180deg, var(--color-moss) 0%, var(--color-moss-soft) 100%);
}

.exp-blocks {
  display: flex;
  flex-direction: column;
  gap: 32px;
}

.exp-blocks h4 {
  font-family: var(--font-sans);
  font-size: 18px;
  font-weight: var(--fw-semi);
  color: var(--color-text-primary);
  margin: 0 0 12px;
  line-height: 30px;
}

.exp-blocks ul {
  list-style: disc;
  padding-left: 20px;
  margin: 0;
  font-family: var(--font-sans);
  font-size: 16px;
  line-height: 26px;
  color: var(--color-text-secondary);
}
.exp-blocks li::marker {
  color: var(--color-moss);
}

.exp-cta {
  margin-top: 32px;
}
.exp-cta .lbl-wide { display: none; }

@media (min-width: 960px) {
  .twocol-grid {
    grid-template-columns: 1fr 1fr;
    gap: 64px;
