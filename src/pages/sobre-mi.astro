<script>
  // Carrusel genérico de dots + flecha, reutilizado por "Mi historia" y "Colaboraciones".
  // sobre-mi.astro no usa transition:persist, así que tras una navegación SPA
  // del ClientRouter este <script> se inserta de nuevo pero el navegador no
  // lo ejecuta salvo que reaccionemos al evento astro:page-load (se dispara
  // tanto en la carga inicial como en cada navegación posterior).
  document.addEventListener('astro:page-load', () => {
    // Puente entre el loop automático del peek (mobile) y el drag manual:
    // initColabDrag pausa/reanuda el loop para que no compitan por el
    // transform de las mismas ghost. initColabPeekLoop rellena la
    // implementación real; por defecto son no-ops (p.ej. en desktop).
    let pauseColabPeekLoop = () => {};
    let resumeColabPeekLoop = () => {};

    function initCarousel(slideSelector: string, dotsId: string, nextId: string, label: string, onChange?: (slide: Element) => void) {
      const slides = Array.from(document.querySelectorAll(slideSelector));
      const dotsWrap = document.getElementById(dotsId);
      if (!slides.length || !dotsWrap) return;

      dotsWrap.innerHTML = '';
      let idx = 0;

      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `${label} ${i + 1}`);
        dot.addEventListener('click', () => go(i));
        dotsWrap.appendChild(dot);
      });
      const dots = Array.from(dotsWrap.children);

      function go(n: number) {
        idx = (n + slides.length) % slides.length;
        slides.forEach((slide, i) => slide.classList.toggle('active', i === idx));
        dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === idx)));
        onChange?.(slides[idx]);
      }

      document.getElementById(nextId)?.addEventListener('click', () => go(idx + 1));
      go(0);
    }

    // Carrusel del hero: los fragmentos viven uno junto a otro en .hero-track;
    // arrastrar (o pulsar la flecha) desplaza el track para que el siguiente/
    // anterior entre visiblemente por el borde, en vez de solo hacer fade.
    function initHeroCarousel() {
      const cardEl = document.querySelector<HTMLElement>('.hero-card');
      const trackEl = document.getElementById('heroTrack');
      const dotsWrap = document.getElementById('heroDots');
      const heroTitle = document.getElementById('heroTitle');
      if (!cardEl || !trackEl || !dotsWrap) return;
      const card = cardEl;
      const track = trackEl;

      const slides = Array.from(track.children) as HTMLElement[];
      if (!slides.length) return;

      dotsWrap.innerHTML = '';
      let idx = 0;
      let dx = 0;

      slides.forEach((_, i) => {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.setAttribute('role', 'tab');
        dot.setAttribute('aria-label', `Fragmento ${i + 1}`);
        dot.addEventListener('click', () => go(i));
        dotsWrap.appendChild(dot);
      });
      const dots = Array.from(dotsWrap.children);

      function place(offset: number) {
        track.style.transform = `translateX(calc(${-idx * 100}% + ${offset}px))`;
      }

      function go(n: number) {
        idx = (n + slides.length) % slides.length;
        dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === idx)));
        if (heroTitle) heroTitle.textContent = slides[idx].dataset.title ?? '';
        place(0);
      }

      document.getElementById('heroNext')?.addEventListener('click', () => go(idx + 1));

      const DRAG_THRESHOLD = 60;
      let startX = 0;
      let startY = 0;
      let dragging = false;
      let axisLocked: 'x' | 'y' | null = null;

      card.addEventListener('touchstart', (e) => {
        const t = e.touches[0];
        startX = t.clientX;
        startY = t.clientY;
        dx = 0;
        dragging = true;
        axisLocked = null;
        track.classList.add('dragging');
      }, { passive: true });

      card.addEventListener('touchmove', (e) => {
        if (!dragging) return;
        const t = e.touches[0];
        dx = t.clientX - startX;
        const dy = t.clientY - startY;
        if (!axisLocked) axisLocked = Math.abs(dx) > Math.abs(dy) ? 'x' : 'y';
        if (axisLocked === 'x') place(dx);
      }, { passive: true });

      function release() {
        if (!dragging) return;
        dragging = false;
        track.classList.remove('dragging');
        if (axisLocked === 'x' && Math.abs(dx) >= DRAG_THRESHOLD) {
          go(dx < 0 ? idx + 1 : idx - 1);
        } else {
          place(0);
        }
      }
      card.addEventListener('touchend', release);
      card.addEventListener('touchcancel', release);

      window.addEventListener('resize', () => place(0));

      go(0);
    }

    // Stack "peek" de Colaboraciones: hover abre las ghost en abanico; no
    // toca los dots ni la flecha, que siguen navegando el carrusel aparte.
    function initColabPeek() {
      const stack = document.querySelector<HTMLElement>('.colab-carousel');
      if (!stack) return;
      if (window.matchMedia('(max-width: 879px)').matches) return; // en mobile, ver initColabPeekLoop

      stack.addEventListener('mouseenter', () => stack.classList.add('is-peeking'));
      stack.addEventListener('mouseleave', () => stack.classList.remove('is-peeking'));

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          stack.classList.add('is-peeking');
          setTimeout(() => stack.classList.remove('is-peeking'), 900);
          observer.disconnect();
        });
      }, { threshold: 0.5 });
      observer.observe(stack);
    }

