    // real (foto + nombre), leídos del propio slide activo, para que al
    // abrir el abanico se vea a quién hay detrás en vez de una card vacía.
    function fillGhost(ghost: Element | null, slide: Element | undefined) {
      if (!ghost || !slide) return;
      const avatarSrc = slide.querySelector<HTMLElement>('.person-avatar')?.style.backgroundImage ?? '';
      const name = slide.querySelector('.person-name')?.textContent ?? '';
      const role = slide.querySelector('.person-role')?.textContent ?? '';
      const ghostAvatar = ghost.querySelector<HTMLElement>('.ghost-avatar');
      const ghostName = ghost.querySelector('.ghost-name');
      const ghostRole = ghost.querySelector('.ghost-role');
      if (ghostAvatar) ghostAvatar.style.backgroundImage = avatarSrc;
      if (ghostName) ghostName.textContent = name;
      if (ghostRole) ghostRole.textContent = role;
    }

    function updateGhosts(currentSlide: Element) {
      const slides = Array.from(document.querySelectorAll('.person-card .person-slide'));
      const i = slides.indexOf(currentSlide);
      if (i === -1) return;
      const prev = slides[(i - 1 + slides.length) % slides.length];
      const next = slides[(i + 1) % slides.length];
      fillGhost(document.querySelector('.ghost.g1'), prev);
      fillGhost(document.querySelector('.ghost.g2'), next);
    }

    // Peek automático en mobile: una sola vez, al entrar la sección en el
    // viewport, las dos ghost "suben" (translateY proporcional al alto real
    // de la card, sin rotación ni desplazamiento horizontal), se mantienen
    // arriba un momento y vuelven a su posición idle. No se repite después.
    // Los dots viven fuera de la card y no se tocan aquí.
    function initColabPeekLoop() {
      if (!window.matchMedia('(max-width: 879px)').matches) return;
      const cardEl = document.querySelector<HTMLElement>('.person-card');
      const stackEl = document.querySelector<HTMLElement>('.colab-carousel');
      const g1El = document.querySelector<HTMLElement>('.ghost.g1');
      const g2El = document.querySelector<HTMLElement>('.ghost.g2');
      if (!cardEl || !stackEl || !g1El || !g2El) return;
      const card = cardEl;
      const g1 = g1El;
      const g2 = g2El;

      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const RISE_MS = prefersReduced ? 0 : 250;
      const HOLD_MS = prefersReduced ? 0 : 900;
      const FALL_MS = prefersReduced ? 0 : 400;

      let played = false;
      let holdTimeoutId: ReturnType<typeof setTimeout> | null = null;

      function resetGhostStyles() {
        g1.style.transition = '';
        g1.style.transform = '';
        g2.style.transition = '';
        g2.style.transform = '';
      }

      function runOnce() {
        if (played) return;
        played = true;

        const h = card.offsetHeight;
        const level2Y = -(h * 0.19);
        const level3Y = -(h * 0.375);

        g1.style.transition = `transform ${RISE_MS}ms ease-out`;
        g2.style.transition = `transform ${RISE_MS}ms ease-out`;
        g1.style.transform = `translateY(${level2Y}px) scale(1)`;
        g2.style.transform = `translateY(${level3Y}px) scale(1)`;

        holdTimeoutId = setTimeout(() => {
          holdTimeoutId = null;
          g1.style.transition = `transform ${FALL_MS}ms ease-in`;
          g2.style.transition = `transform ${FALL_MS}ms ease-in`;
          g1.style.transform = '';
          g2.style.transform = '';
        }, RISE_MS + HOLD_MS);
      }

      function stop() {
        if (holdTimeoutId !== null) {
          clearTimeout(holdTimeoutId);
          holdTimeoutId = null;
        }
        resetGhostStyles();
      }

      // El drag pausa el peek si llega a mitad de animación; como es de una
      // sola vez, "reanudar" simplemente evita que se repita más adelante.
      pauseColabPeekLoop = () => {
        played = true;
        stop();
      };
      resumeColabPeekLoop = () => {};

      if (prefersReduced) return;

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          runOnce();
          observer.disconnect();
        });
      }, { threshold: 0.5 });
      observer.observe(stackEl);
    }

    // Los dots viven dentro de .person-card en el markup (así en desktop
    // quedan superpuestos a la card, sin tocar nada). En mobile .person-card
    // recibe un transform durante el drag/swipe, y como transform crea un
    // nuevo containing block para sus descendientes position:absolute, los
    // dots se moverían con la card si se quedan dentro. Los reparentamos a
    // .person-stack (hermano de la card, nunca se transforma) solo mientras
    // el viewport es mobile, y los devolvemos a su sitio original en desktop
    // para no alterar en absoluto su marcado/posición ahí.
    function initColabNav() {
      const stack = document.querySelector<HTMLElement>('.person-stack');
      const card = document.querySelector<HTMLElement>('.person-card');
      const nav = document.querySelector<HTMLElement>('.person-nav');
      if (!stack || !card || !nav) return;

      function sync() {
        if (window.matchMedia('(max-width: 879px)').matches) {
          if (nav.parentElement !== stack) stack.appendChild(nav);
        } else {
          if (nav.parentElement !== card) card.appendChild(nav);
        }
      }

      sync();
      window.addEventListener('resize', sync);
    }

    // En mobile no hay flecha: deslizar la card frontal hacia la izquierda
    // avanza al siguiente colaborador (mismo gesto que el carrusel del hero),
    // reutilizando el click del botón #colabNext para no duplicar el go()
    // que ya vive dentro de initCarousel. Mientras se arrastra, la ghost
    // "g2" (siguiente) se anima de "asomando arriba" a "lista en el centro"
    // para insinuar la card que está a punto de entrar.
    function initColabDrag() {
      if (!window.matchMedia('(max-width: 879px)').matches) return;
      const cardEl = document.querySelector<HTMLElement>('.person-card');
      const nextBtnEl = document.getElementById('colabNext');
      if (!cardEl || !nextBtnEl) return;
      const card = cardEl;
      const nextBtn = nextBtnEl;

      const DRAG_THRESHOLD = 60;
      const PEEK_DISTANCE = 140;
      let startX = 0;
      let startY = 0;
      let dx = 0;
      let dragging = false;
      let axisLocked: 'x' | 'y' | null = null;

      function lerp(a: number, b: number, t: number) {
