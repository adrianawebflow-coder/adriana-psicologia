---
import Layout from '../layouts/Layout.astro';

const CALENDLY_URL = 'https://calendly.com/adrianapsicologia/15-20min';

const tabs = [
  {
    id: 'individual',
    label: 'Individual',
    price: 'Desde 80 €/sesión suelta',
    bono: '70 €/sesión',
    bonoTotal: '280 €',
    details: [
      'Duración: 55 minutos',
      'Evaluación gratuita en caso de iniciar el tratamiento',
    ],
  },
  {
    id: 'parejas',
    label: 'Parejas',
    price: 'Desde 90 €/sesión suelta',
    bono: '80 €/sesión',
    bonoTotal: '320 €',
    details: [
      'Duración: 55 minutos',
      'Evaluación gratuita en caso de iniciar el tratamiento',
    ],
  },
  {
    id: 'familias',
    label: 'Familias',
    price: 'Desde 100 €/sesión suelta',
    bono: '90 €/sesión',
    bonoTotal: '360 €',
    details: [
      'Duración: 55 minutos',
      'Evaluación gratuita en caso de iniciar el tratamiento',
    ],
  },
];

// Cada apartado se muestra como un desplegable con su texto.
const normativa = [
  {
    title: 'Política de cancelación',
    text: 'Se cobrarán las citas canceladas con menos de 24 h de antelación.',
  },
  {
    title: 'Privacidad',
    text: 'En caso de que el espacio no asegure la privacidad e intimidad del paciente, el profesional se reserva el derecho a paralizar la sesión y reubicar la cita.',
  },
  {
    title: 'Puntualidad',
    text: 'Se requiere flexibilidad para las ocasiones en las que el terapeuta pueda alargarse con un paciente anterior y generar un retraso en las consultas siguientes.',
  },
];

const initial = tabs[0].id;
---

<Layout
  title="Precio"
  description="Precios de terapia individual, de pareja y familiar: citas sueltas o bonos descuento de 4 sesiones. Sesiones de 55 minutos y evaluación gratuita si inicias el tratamiento."
>

  <section class="precio-section" id="precio">
      <div class="precio-left">
       <div class="precio-left-inner">
        <h1>Invierte en tu salud</h1>
        <p class="lede">Existe la posibilidad de escoger citas sueltas o reducir el coste del tratamiento utilizando bonos descuento (paquetes de 4 sesiones que se van consumiendo en el tiempo).</p>

        <div class="tabs" role="tablist" aria-label="Tipo de terapia" id="tabs">
          {tabs.map((tab) => (
            <button
              class:list={['tab', { active: tab.id === initial }]}
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={tab.id === initial}
              tabindex={tab.id === initial ? 0 : -1}
              data-tab={tab.id}
              type="button"
            >
              {tab.label}
            </button>
          ))}
        </div>

        {tabs.map((tab) => (
          <div
            class="info-cards"
            id={`panel-${tab.id}`}
            role="tabpanel"
            tabindex="0"
            aria-labelledby={`tab-${tab.id}`}
            data-panel={tab.id}
            hidden={tab.id !== initial}
          >
            <div class="card">
              <p class="price-label">Precio</p>
              <p class="price-value">{tab.price}</p>
              <ul class="details-list">
                {tab.details.map((d) => <li>{d}</li>)}
              </ul>
            </div>

            <div class="card bono-card">
              <p class="bono-title">
                <span class="badge-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/>
                    <path d="M9 9h.01"/>
                    <path d="m15 9-6 6"/>
                    <path d="M15 15h.01"/>
                  </svg>
                </span>
                Bono descuento: {tab.bono}
              </p>
              <p class="bono-desc">Paquete de 4 sesiones ({tab.bonoTotal} en total) que se van consumiendo en el tiempo.</p>
            </div>
          </div>
        ))}
       </div>
      </div>

      <div class="precio-right">
        <div class="normativa-content">
          <h2 id="normativa">Normativa terapéutica</h2>
          <p class="lede-sm">El autocuidado empieza con el compromiso.</p>

          <div class="accordion-list">
            {normativa.map((n) => (
              <details class="accordion-item reveal">
                <summary>
                  <span>{n.title}</span>
                  <span class="chevron" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m6 9 6 6 6-6"/>
                    </svg>
                  </span>
                </summary>
                <p class="accordion-text">{n.text}</p>
              </details>
            ))}
          </div>
        </div>

        <div class="precio-cta">
          <h3>Tu bienestar también merece ser una prioridad</h3>
          <a class="btn btn-light" href={CALENDLY_URL} target="_blank" rel="noopener">
            Reserva tu cita aquí →
          </a>
        </div>
      </div>
  </section>

</Layout>

<style>
.precio-section {
  display: flex;
  flex-direction: column;
  max-width: 1280px;
  margin: 0 auto;
}

.precio-left {
  background: var(--color-bg-soft);
  padding: 40px var(--gutter) 24px;
  display: flex;
  flex-direction: column;
}
.precio-left-inner {
  display: flex;
  flex-direction: column;
  width: 100%;
}

.precio-right {
  background: var(--color-bg-base);
  display: flex;
  flex-direction: column;
}
.normativa-content {
  background: var(--color-clay-soft);
  padding: 40px var(--gutter) 60px;
}

.precio-left h1 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 34px;
  line-height: 1.2;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.precio-left .lede {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 32px;
}

.tabs {
  display: flex;
  align-items: center;
  border-bottom: 2px solid var(--color-clay-soft);
  margin-bottom: 20px;
}
.tab {
  flex: 1 1 auto;
  padding: 0 12px 12px;
  text-align: center;
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  font-weight: var(--fw-regular);
  color: var(--color-text-muted);
  border-bottom: 2px solid transparent;
  margin-bottom: -2px;
  background: none;
  border-top: none;
  border-left: none;
  border-right: none;
  cursor: pointer;
}
.tab.active {
  font-weight: var(--fw-semi);
  color: var(--color-text-secondary);
  border-bottom-color: var(--color-text-secondary);
}

.info-cards {
  display: flex;
  flex-direction: column;
  gap: 20px;
  margin-bottom: 20px;
}
.info-cards[hidden] { display: none; }

/* Las cards de precio/bono reaparecen con un fade-up cada vez que se
   muestra su panel: al no estar hidden, empiezan a matchear este
   selector de nuevo y el navegador reinicia la animación desde cero,
   tanto en la carga inicial como en cada cambio de tab. */
@keyframes precioCardIn {
  from { opacity: 0; transform: translateY(12px); }
  to   { opacity: 1; transform: translateY(0); }
}
.info-cards:not([hidden]) .card {
  animation: precioCardIn 420ms cubic-bezier(0.25, 0, 0, 1) both;
}
.info-cards:not([hidden]) .card:nth-child(2) {
  animation-delay: 80ms;
}
@media (prefers-reduced-motion: reduce) {
  .info-cards:not([hidden]) .card {
    animation: none;
  }
}

.card {
  background: var(--color-bg-base);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  padding: 16px;
}
.price-label {
  font-family: var(--font-sans);
  font-weight: var(--fw-semi);
  font-size: var(--fs-body-sm);
  letter-spacing: var(--ls-wide);
  color: var(--color-text-muted);
  text-transform: uppercase;
  margin: 0 0 8px;
}
.price-value {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 22px;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.details-list {
  list-style: none;
  margin: 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.details-list li {
  position: relative;
  padding-left: 20px;
  font-family: var(--font-sans);
  font-weight: var(--fw-regular);
  font-size: var(--fs-body-sm);
  line-height: 1.7;
  color: var(--color-text-primary);
}
.details-list li::before {
  content: "•";
  position: absolute;
  left: 2px;
  color: var(--color-text-primary);
}

.badge-icon {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  color: var(--color-clay);
}
.bono-title {
  display: flex;
  align-items: center;
  gap: 10px;
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 18px;
  color: var(--color-text-primary);
  margin: 0 0 16px;
}
.bono-desc {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  height: 48px;
  padding: 8px 16px;
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  white-space: nowrap;
  transition: transform var(--transition-fast), filter var(--transition-fast);
  border: none;
  cursor: pointer;
  text-decoration: none;
}
.btn:hover { transform: translateY(-1px); filter: brightness(1.06); }
.btn-light {
  background: var(--color-bg-base);
  color: var(--color-text-primary);
  font-weight: var(--fw-semi);
}
.btn-light:hover { color: var(--color-text-primary); }

/* ── Normativa terapéutica (derecha) ── */
.normativa-content h2 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: var(--fs-h2);
  color: var(--color-text-primary);
  letter-spacing: var(--ls-tight);
  margin: 0 0 16px;
}
.lede-sm {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: var(--color-text-secondary);
  margin: 0 0 32px;
}

.accordion-list {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.accordion-item {
  background: #F5F2EA;
  border: none;
  border-radius: var(--radius-lg);
  padding: 4px 20px;
}
.accordion-item summary {
  list-style: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 0;
  cursor: pointer;
  font-family: var(--font-sans);
  font-weight: var(--fw-medium);
  font-size: var(--fs-body);
  color: var(--color-text-primary);
}
.accordion-item summary::-webkit-details-marker { display: none; }
.accordion-item .chevron {
  flex: 0 0 28px;
  width: 28px;
  height: 28px;
  border-radius: 50%;
  background: var(--color-clay-soft);
  color: var(--color-clay-hover);
  display: grid;
  place-items: center;
  transition: transform var(--transition-fast);
}
.accordion-item[open] .chevron { transform: rotate(180deg); }
.accordion-text {
  font-family: var(--font-sans);
  font-size: var(--fs-body-sm);
  line-height: 1.7;
  color: var(--color-text-primary);
  margin: 0;
  padding-bottom: 20px;
}

/* ── CTA (dentro de la columna derecha, debajo de normativa) ── */
.precio-cta {
  --focus-ring: var(--focus-ring-on-dark);
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  background: var(--color-clay);
  color: #fff;
  padding: 40px var(--gutter);
}
.precio-cta h3 {
  font-family: var(--font-serif);
  font-weight: var(--fw-semi);
  font-size: 24px;
  color: #fff;
  margin: 0 0 24px;
  max-width: 22ch;
}
.precio-cta p {
  font-family: var(--font-sans);
  font-size: var(--fs-body);
  line-height: 1.6;
  color: #fff;
  margin: 0 0 32px;
  max-width: 40ch;
}

@media (min-width: 1000px) {
  .precio-section { flex-direction: row; align-items: stretch; }
  .precio-left { flex: 1 1 0; padding: 80px 60px; }
  .precio-left h1 { font-size: 44px; }
  .precio-right { flex: 1 1 0; }
  .normativa-content { padding: 80px 60px 40px; }

  /* A partir de aquí el contenido deja de crecer con la ventana; solo
     el color de fondo de cada columna sigue ocupando el espacio
     disponible. */
  .precio-left-inner,
  .normativa-content {
    max-width: 640px;
  }
}
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const tabsWrap = document.getElementById('tabs');
    if (!tabsWrap) return;

    const tabButtons = Array.from(tabsWrap.querySelectorAll<HTMLButtonElement>('.tab'));
    const panels = Array.from(document.querySelectorAll<HTMLElement>('.info-cards[data-panel]'));

    function select(id: string) {
      tabButtons.forEach((btn) => {
        const active = btn.dataset.tab === id;
        btn.classList.toggle('active', active);
        btn.setAttribute('aria-selected', String(active));
        btn.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.panel !== id;
      });
    }

    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.tab) select(btn.dataset.tab);
      });
    });

    // Patrón de pestañas ARIA: flechas, Inicio/Fin y tabindex itinerante.
    tabButtons.forEach((btn, i) => {
      btn.addEventListener('keydown', (e) => {
        const map: Record<string, number> = {
          ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabButtons.length - 1,
        };
        if (!(e.key in map)) return;
        e.preventDefault();
        const next = tabButtons[(map[e.key] + tabButtons.length) % tabButtons.length];
        if (next.dataset.tab) select(next.dataset.tab);
        next.focus();
      });
    });
  });
</script>
